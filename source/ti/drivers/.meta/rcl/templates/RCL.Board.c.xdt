{
    .enableTemperatureMonitoring = true,
    .enablePaEsdProtection = true,
    .enableTxOutputPowerCompensation = true,
};
%}
%if (board !== undefined && board.name.match(/CC27/)) {
/*
 * ======== RCL Regulatory Domain Configuration ========
