                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NLNKD</name>
                           <value>0x0</value>
                           <description>This Host is not linked to Mailbox</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB2OUT</name>
                     <description>Output Mailbox 2 Status</description>
