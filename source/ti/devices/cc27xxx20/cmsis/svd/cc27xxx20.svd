                     <access>read-only</access>
                  </field>
                  <field>
                     <name>RES0_3</name>
                     <description>Reserved, RES0</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>REGION</name>
                     <description>Indicates the memory region accessed by MPU_RBAR and MPU_RLAR</description>
                     <bitRange>[2:0]</bitRange>
