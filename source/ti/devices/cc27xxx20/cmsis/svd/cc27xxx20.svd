                     <description>Arming channel 5 for either compare or capture operation.</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>if channel 5 is in CAPTURE state then no effect on the channel else it can set channel in COMPARE mode using existing CH4CC.VAL value.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No effect on the channel</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
