                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MB1PACC</name>
                     <description>0: Mailbox 1 can be accessed by the Host using protected or non-protected access. 1: Mailbox 1 is only accessible if the Host uses protected access.</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MB1LNKID</name>
                     <description>Host cpu_id of the Host linked to the Mailbox 1</description>
                     <bitRange>[2:0]</bitRange>
