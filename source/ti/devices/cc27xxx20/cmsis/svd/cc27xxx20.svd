                           <value>0x1</value>
                           <description>This Host is linked to Mailbox</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NLNKD</name>
                           <value>0x0</value>
                           <description>This Host is not linked to Mailbox</description>
