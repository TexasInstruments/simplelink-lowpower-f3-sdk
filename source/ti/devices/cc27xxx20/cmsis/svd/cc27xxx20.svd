                     <description>Minimum IDAC current</description>
                     <bitRange>[22:16]</bitRange>
                  </field>
                  <field>
                     <name>IREF</name>
                     <description>Target HFXT IREF current</description>
                     <bitRange>[15:12]</bitRange>
                  </field>
