                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>START</name>
                           <value>0x1</value>
                           <description>OTP Start</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DONE</name>
                           <value>0x0</value>
                           <description>OTP Done</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OTPEVTCLR</name>
                     <description>OTP Event Clear</description>
                     <bitRange>[3:3]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
