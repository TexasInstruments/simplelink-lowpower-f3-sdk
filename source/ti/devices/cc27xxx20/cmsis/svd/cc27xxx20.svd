            <register>
               <name>TXD</name>
               <description>TX FIFO data. When written the register data is pushed to the TX FIFO. When read, data is popped from the TX FIFO</description>
               <addressOffset>0</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>TX FIFO data. When written the register data is pushed to the TX FIFO. When read, data is popped from the TX FIFO. When writing or reading this register the access size will determine how many bytes are pushed to or popped from the FIFO. It is possible to push or pop 1,2 or 4 bytes depending on the access being done.</description>
                     <bitRange>[31:0]</bitRange>
                  </field>
               </fields>
            </register>
         </registers>
