                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB2LNK</name>
                     <description>Link Mailbox to this Host. Host can link to a mailbox only if it is not filled and not linked to another host</description>
                     <bitRange>[6:6]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
