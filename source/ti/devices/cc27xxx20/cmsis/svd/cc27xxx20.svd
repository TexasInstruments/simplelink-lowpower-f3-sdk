                  <field>
                     <name>EXTRMAP</name>
                     <description>Extended register map.</description>
                     <bitRange>[7:7]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INPUTS</name>
                     <description>The number of interrupt request inputs.</description>
                     <bitRange>[5:0]</bitRange>
                     <access>read-only</access>
                  </field>
