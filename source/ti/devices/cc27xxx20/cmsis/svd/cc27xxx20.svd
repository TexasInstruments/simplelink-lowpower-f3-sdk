                           <name>TX_OTO_TRIG</name>
                           <value>0x0</value>
                           <description>MCAN TX Buffer one-to-one Tx BRP (buffer request pending) trigger to DMA channel select</description>
                        </enumeratedValue>
                     </enumeratedValues>
