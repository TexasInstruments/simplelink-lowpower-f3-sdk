      <peripheral>
         <name>SYSTICK</name>
         <description></description>
         <baseAddress>0xE000E010</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00000010</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>SYST_CSR</name>
               <description>Controls and provides status date for the SysTick timer</description>
               <addressOffset>0</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RES17</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[31:17]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>COUNTFLAG</name>
                     <description>Indicates whether the counter has counted to zero since the last read of this register</description>
                     <bitRange>[16:16]</bitRange>
                  </field>
                  <field>
                     <name>RES3</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[15:3]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>CLKSOURCE</name>
                     <description>Indicates the SysTick clock source</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>TICKINT</name>
                     <description>Indicates whether counting to 0 causes the status of the SysTick exception to change to pending</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>ENABLE</name>
                     <description>Indicates the enabled status of the SysTick counter</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYST_RVR</name>
               <description>Specifies the SysTick timer counter reload value</description>
               <addressOffset>4</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RES24</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[31:24]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>RELOAD</name>
                     <description>Value to load into the SYST_CVR when the counter is enabled and when it reaches 0</description>
                     <bitRange>[23:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYST_CVR</name>
               <description>Contains the current value of the SysTick counter</description>
               <addressOffset>8</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RES24</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[31:24]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>CURRENT</name>
                     <description>Reads the current value of the SysTick counter.
A write of any value clears the field to 0, and also clears the SYST_CSR.COUNTFLAG bit to 0.</description>
                     <bitRange>[23:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYST_CALIB</name>
               <description>Indicates the SysTick calibration value and parameters for the selected security state</description>
               <addressOffset>12</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RES24_2</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[31:31]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>SKEW</name>
                     <description>Indicates whether the TENMS value is exact</description>
                     <bitRange>[30:30]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>RES24</name>
                     <description>Software should not rely on the value of a reserved. Writing any other value than the reset value may result in undefined behavior.</description>
                     <bitRange>[29:24]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>TENMS</name>
                     <description>Reload value for 10ms (100Hz) timing, subject to system clock skew errors. If the value reads as zero, the
calibration value is not known.</description>
                     <bitRange>[23:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>SYSTIM</name>
         <description>SVT System Timer Module
</description>
