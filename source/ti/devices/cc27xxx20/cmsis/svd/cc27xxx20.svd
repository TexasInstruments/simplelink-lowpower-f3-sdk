            <register>
               <name>MBCTL</name>
               <description>Mailbox Control Register</description>
               <addressOffset>16128</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>MB2ULNK</name>
