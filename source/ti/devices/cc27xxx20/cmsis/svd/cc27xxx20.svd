            <register>
               <name>HFXTTARG</name>
               <description>Target values for HFXT ramping</description>
               <addressOffset>284</addressOffset>
               <access>read-write</access>
               <resetValue>0x54464b6d</resetValue>
               <fields>
                  <field>
                     <name>AMPHYST</name>
                     <description>ADC hysteresis used during IDAC updates.

Every AMPCFG1.INTERVAL, IDAC will be regulated
- up as long as ADC $lt; AMPTHR
- down as long as ADC $gt; AMPTHR+AMPHYST</description>
                     <bitRange>[31:30]</bitRange>
                  </field>
                  <field>
                     <name>AMPTHR</name>
                     <description>Minimum HFXT amplitude</description>
                     <bitRange>[29:23]</bitRange>
                  </field>
                  <field>
                     <name>IDAC</name>
                     <description>Minimum IDAC current</description>
                     <bitRange>[22:16]</bitRange>
                  </field>
                  <field>
                     <name>IREF</name>
                     <description>Target HFXT IREF current</description>
                     <bitRange>[15:12]</bitRange>
                  </field>
                  <field>
                     <name>Q2CAP</name>
                     <description>Target HFXT Q2 cap trim</description>
                     <bitRange>[11:6]</bitRange>
