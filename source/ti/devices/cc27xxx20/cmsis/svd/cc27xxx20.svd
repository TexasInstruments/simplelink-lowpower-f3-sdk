                           <value>0x7</value>
                           <description>IOC synchronous combined event, controlled by IOC:EVTCFG</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AON_LPMCMP_IRQ</name>
                           <value>0x6</value>
                           <description>AON LPCMP interrupt, controlled by SYS0:LPCMPCFG</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AON_DBG_COMB</name>
                           <value>0x5</value>
                           <description>DebugSS combined interrupt, interrupt flags can be found here DBGSS:MIS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AON_RTC_COMB</name>
                           <value>0x4</value>
                           <description>AON_RTC event, controlled by the RTC:IMASK setting</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AON_CKM_COMB</name>
                           <value>0x3</value>
                           <description>CKMD combined interrupt request, interrupt flags can be found here CKMD:MIS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AON_PMU_COMB</name>
                           <value>0x2</value>
                           <description>PMU combined interrupt request for BATMON, interrupt flags can be found here PMUD:EVENT</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NONE</name>
                           <value>0x0</value>
                           <description>Always inactive</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>WKUPMASK</name>
               <description>WAKEUP Mask Register.
</description>
               <addressOffset>2048</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>AON_IOC_COMB</name>
                     <description>Wake-up mask for AON_IOC_COMB.
</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AON_LPMCMP_IRQ</name>
                     <description>Wake-up mask for AON_LPCMP_IRQ.
</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AON_DBG_COMB</name>
                     <description>Wake-up mask for AON_DBG_COMB.
</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AON_RTC_COMB</name>
                     <description>Wake-up mask for AON_RTC_COMB.
</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AON_CKM_COMB</name>
                     <description>Wake-up mask for AON_CKM_COMB.
</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AON_PMU_COMB</name>
                     <description>Wake-up mask for AON_PMU_COMB.</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Wakeup enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Wakeup disabled </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>FLASH</name>
         <description></description>
         <baseAddress>0x40021000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>IIDX</name>
               <description>Interrupt Index Register:
The IIDX register provides the highest priority enabled interrupt index.

PSD compliant register.
Note that it is not recommended to use this register if the system clock is
running at a slower clock frequency than the flash wrapper clock.  If this is the
case, then reading this register may fail to update the RIS register correctly.
The MIS register should be read directly, and a write to ICLR should be used to
clear interrupts when this clock relationship is present.</description>
               <addressOffset>32</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STAT</name>
                     <description>Indicates which interrupt has fired. 0x0 means no event pending. The priority order is fixed. On each read, only one interrupt is indicated. On a read, the current interrupt (highest priority) is automatically cleared by the hardware and the corresponding interrupt flags in the RIS and MIS are cleared as well. After a read from the CPU (not from the debug interface), the register must be updated with the next highest priority interrupt.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DONE</name>
                           <value>0x1</value>
                           <description>DONE Interrupt Pending</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_INTR</name>
                           <value>0x0</value>
                           <description>No Interrupt Pending</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IMASK</name>
               <description>Interrupt Mask Register:
The IMASK register holds the current interrupt mask settings. Masked interrupts
are read in the MIS register. PSD compliant register.</description>
               <addressOffset>40</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DONE</name>
                     <description>Interrupt mask for DONE:
0: Interrupt is disabled in MIS register
1: Interrupt is enabled in MIS register</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <value>0x1</value>
                           <description>Interrupt will request an interrupt service routine and corresponding bit in IPSTANDARD.MIS will be set</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <value>0x0</value>
                           <description>Interrupt is masked out</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RIS</name>
               <description>Raw Interrupt Status Register:
The RIS register reflects all pending interrupts, regardless of masking. 
The RIS register allows the user to implement a poll scheme. A flag set in this
register can be cleared by writing a 1 to the ICLR register bit even if the 
corresponding IMASK bit is not enabled. A flag can be set by software by writing
a 1 to the ISET register. Reading the IIDX register will also clear the
corresponding bit in RIS. PSD compliant register.</description>
               <addressOffset>48</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DONE</name>
                     <description>Flash wrapper operation completed.
This interrupt bit is set by firmware or the corresponding bit in the ISET register.
It is cleared by the corresponding bit in in the ICLR register or reading the IIDX register when this interrupt is the highest priority.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occurred</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MIS</name>
               <description>Masked Interrupt Status Register:
The MIS register is a bit-wise AND of the contents of the IMASK and RIS 
registers. This is kept mainly for ARM compatibility, and has limited use since
 the highest priority interrupt index is returned via the IIDX register.
 PSD 
compliant register.</description>
               <addressOffset>56</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DONE</name>
                     <description>Flash wrapper operation completed.
This masked interrupt bit reflects the bitwise AND of the corresponding RIS and IMASK bits.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Masked interrupt occurred</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Masked interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ISET</name>
               <description>Interrupt Set Register:
The ISET register allows software to write a 1 to set corresponding interrupt. 

Safety:
This meets a safety requirement to allow software diagnostics to trigger 
interrupts.
PSD compliant register.</description>
               <addressOffset>64</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DONE</name>
                     <description>0: No effect
1: Set the DONE interrupt in the RIS register</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set IPSTANDARD.RIS bit</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_EFFECT</name>
                           <value>0x0</value>
                           <description>Writing a 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ICLR</name>
               <description>Interrupt Clear Register. 
The ICLR register allows allows software to write a 1 to clear corresponding 
interrupt.
PSD compliant register.</description>
               <addressOffset>72</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DONE</name>
                     <description>0: No effect
1: Clear the DONE interrupt in the RIS register</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear IPSTANDARD.RIS bit</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_EFFECT</name>
                           <value>0x0</value>
                           <description>Writing a 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>EVT_MODE</name>
               <description>Event mode register. It is used to select whether each line is disabled, in 
software mode (software clears the RIS) or in hardware mode (hardware 
clears the RIS).</description>
               <addressOffset>224</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>INT0_CFG</name>
                     <description>Event line mode select for peripheral event</description>
                     <bitRange>[1:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HARDWARE</name>
                           <value>0x2</value>
                           <description>The interrupt or event line is in hardware mode. Hardware should clear the RIS.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SOFTWARE</name>
                           <value>0x1</value>
                           <description>The interrupt or event line is in software mode. Software must clear the RIS.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>The interrupt or event line is disabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DESC</name>
               <description>Hardware Version Description Register:
This register identifies the flash wrapper hardware version and feature set used. </description>
               <addressOffset>252</addressOffset>
               <access>read-only</access>
               <resetValue>0x0b404010</resetValue>
               <fields>
                  <field>
                     <name>MODULEID</name>
                     <description>Module ID</description>
                     <bitRange>[31:16]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xffff</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FEATUREVER</name>
                     <description>Feature set</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xf</value>
                           <description>Maximum Value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Minimum Value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INSTNUM</name>
                     <description>Instance number</description>
                     <bitRange>[11:8]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xf</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MAJREV</name>
                     <description>Major Revision</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xf</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor Revision</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xf</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMDEXEC</name>
               <description>Command Execute Register:
Initiates execution of the command specified in the CMDTYPE register.
This register is blocked for writes after being written to 1 and prior to 
STATCMD.DONE being set by the flash wrapper hardware.
flash wrapper hardware clears this register after the processing of the command 
has completed.
</description>
               <addressOffset>256</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Command Execute value
Initiates execution of the command specified in the CMDTYPE register.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EXECUTE</name>
                           <value>0x1</value>
                           <description>Command will execute or is executing in flash wrapper</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEXECUTE</name>
                           <value>0x0</value>
                           <description>Command will not execute or is not executing in flash wrapper</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMDTYPE</name>
               <description>Command Type Register
This register specifies the type of command to be executed by the flash wrapper
hardware.
This register is blocked for writes after CMDEXEC is written to a 1 and 
prior to STATCMD.DONE being set by the hardware to indicate that 
command execution has completed.</description>
               <addressOffset>260</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SIZE</name>
                     <description>Command size </description>
                     <bitRange>[6:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BANK</name>
                           <value>0x5</value>
                           <description>Operate on an entire flash bank</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SECTOR</name>
                           <value>0x4</value>
                           <description>Operate on a flash sector</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EIGHTWORD</name>
                           <value>0x3</value>
                           <description>Operate on 8 flash words</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FOURWORD</name>
                           <value>0x2</value>
                           <description>Operate on 4 flash words</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TWOWORD</name>
                           <value>0x1</value>
                           <description>Operate on 2 flash words</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONEWORD</name>
                           <value>0x0</value>
                           <description>Operate on 1 flash word</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>COMMAND</name>
                     <description>Command type</description>
                     <bitRange>[2:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BLANKVERIFY</name>
                           <value>0x6</value>
                           <description>Blank Verify - Check whether a flash word is in the erased state.
This command may only be used with CMDTYPE.SIZE = ONEWORD</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLEARSTATUS</name>
                           <value>0x5</value>
                           <description>Clear Status - Clear status bits in FW_SMSTAT only.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MODECHANGE</name>
                           <value>0x4</value>
                           <description>Mode Change - Perform a mode change only, no other operation.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>READVERIFY</name>
                           <value>0x3</value>
                           <description>Read Verify - Perform a standalone read verify operation.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERASE</name>
                           <value>0x2</value>
                           <description>Erase</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PROGRAM</name>
                           <value>0x1</value>
                           <description>Program</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOOP</name>
                           <value>0x0</value>
                           <description>No Operation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMDCTL</name>
               <description>Command Control Register
This register configures specific capabilities of the state machine for related to
the execution of a command.
This register is blocked for writes after CMDEXEC is written to a 1 and 
prior to STATCMD.DONE being set by the hardware to indicate that 
command execution has completed.
</description>
               <addressOffset>264</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATAVEREN</name>
                     <description>Enable invalid data verify.  
This checks for 0-$gt;1 transitions in the memory when
a program operation is initiated.  If such a transition is found, the program will
fail with an error without doing any programming.</description>
                     <bitRange>[21:21]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SSERASEDIS</name>
                     <description>Disable Stair-Step Erase.  If set, the default VHV trim voltage setting will be used
for all erase pulses.
By default, this bit is reset, meaning that the VHV voltage will be stepped during
successive erase pulses.  The step count, step voltage, begin and end voltages
are all hard-wired.</description>
                     <bitRange>[20:20]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x1</value>
                           <description>Disable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x0</value>
                           <description>Enable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADDRXLATEOVR</name>
                     <description>Override hardware address translation of address in CMDADDR from a 
system address to a bank address and bank ID.  Use data written to 
CMDADDR directly as the bank address.  Use the value written to 
CMDCTL.BANKSEL directly as the bank ID.  Use the value written to
CMDCTL.REGIONSEL directly as the region ID.
</description>
                     <bitRange>[16:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OVERRIDE</name>
                           <value>0x1</value>
                           <description>Override</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOOVERRIDE</name>
                           <value>0x0</value>
                           <description>Do not override</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REGIONSEL</name>
                     <description>Bank Region
A specific region ID can be written to this field to indicate to which region an 
operation should be applied if CMDCTL.ADDRXLATEOVR is set.</description>
                     <bitRange>[12:9]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENGR</name>
                           <value>0x8</value>
                           <description>Engr Region</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TRIM</name>
                           <value>0x4</value>
                           <description>Trim Region</description>
                        </enumeratedValue>
                        <enumeratedValue>
