      </peripheral>
      <peripheral>
         <name>I2C0</name>
         <description>I2C IP module with peripheral and controller capabilities 
    </description>
         <baseAddress>0x40038000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>TOAR</name>
               <description>Target Own Address
This register consists of seven address bits that identify this I2C device on the I2C bus.</description>
               <addressOffset>0</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>OAR</name>
                     <description>Target own address. This field specifies bits a6 through a0 of the target address.</description>
                     <bitRange>[6:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>TSTA</name>
               <description>Target status
This register functions as a status register of the target.</description>
               <addressOffset>4</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>FBR</name>
                     <description>First byte received.
This bit is only applicable when the TSTA.RREQ bit is set and is automatically cleared when data has been read from the TDR register.
Note: This bit is not used for target transmit operations.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The first byte following the target&#39;s own address has been received.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The first byte following the target&#39;s own address has not been received</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TREQ</name>
                     <description>This field reflects the transmit request status</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The I2C has been addressed as a target transmitter and is using clock stretching to delay the controller until data has been written to the TDR register</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>No outstanding transmit request</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RREQ</name>
                     <description>This field reflects the receive request status.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The target has outstanding receive data from the external controller and is using clock stretching to delay the controller until data has been read from the TDR register</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>No outstanding receive data</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TCTL</name>
               <description>Target control
This registers functions as a target control register</description>
               <addressOffset>4</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DA</name>
                     <description>This field sets the device active control
</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the target operation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the target operation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TDR</name>
               <description>Target data register 
This register contains the data to be transmitted when in the target transmit state, and the data received
when in the target receive state.</description>
               <addressOffset>8</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>Data for transfer. This field contains the data for transfer during a target receive or a transmit operation. When written, the register data is used as transmit data. When read, this register returns the last data received. Data is stored until next update, either by a system write to the controller for transmit or by an external controller to the target for receive.</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>TIMR</name>
               <description>Target interrupt mask
This register controls whether a raw interrupt is promoted to a controller interrupt</description>
               <addressOffset>12</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STOPIM</name>
                     <description>Stop condition interrupt mask</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STARTIM</name>
                     <description>Start condition interrupt mask</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATAIM</name>
                     <description>Data interrupt mask</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TRIS</name>
               <description>Target raw interrupt status
This register shows the unmasked interrupt status.</description>
               <addressOffset>16</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STOPRIS</name>
                     <description>Stop condition raw interrupt status
This bit is cleared by writing a 1 to TICR.STOPIC.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STARTRIS</name>
                     <description>Start condition raw interrupt status
This bit is cleared by writing a 1 to TICR.STARTIC.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATARIS</name>
                     <description>Data raw interrupt status
This bit is cleared by writing a 1 to TICR.DATAIC.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TMIS</name>
               <description>Target Masked Interrupt Status
This register shows which interrupt is active (based on result from TRIS and TIMR registers).</description>
               <addressOffset>20</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STOPMIS</name>
                     <description>Stop condition masked interrupt status
This bit is cleared by writing a 1 to TICR.STOPIC.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Masked interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Masked interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STARTMIS</name>
                     <description>Start condition masked interrupt status
This bit is cleared by writing a 1 to TICR.STARTIC.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Masked interrput occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Masked interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATAMIS</name>
                     <description>Start condition masked interrupt status
This bit is cleared by writing a 1 to TICR.DATAIC.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Masked interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Masked interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TICR</name>
               <description>Target Interrupt Clear
This register clears the raw interrupt TRIS</description>
               <addressOffset>24</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STOPIC</name>
                     <description>Stop condition interrupt clear
</description>
                     <bitRange>[2:2]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clear interrupt
Writing 1 to this bit clears TRIS.STOPRIS and TMIS.STOPMIS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STARTIC</name>
                     <description>Start condition interrupt clear
</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clear interrupt
Writing 1 to this bit clears TRIS.STARTRIS and TMIS.STARTMIS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATAIC</name>
                     <description>Data interrupt clear
</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clear interrupt
Writing 1 to this bit clears TRIS.DATARIS and TMIS.DATAMIS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTA</name>
               <description>Controller target address
This register contains seven address bits of the target to be accessed by the controller (a6-a0), and an CTA.RS bit determining if the next operation is a receive or transmit</description>
               <addressOffset>2048</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SA</name>
                     <description>Controller target address
Defines which target is addressed for the transaction in controller mode</description>
                     <bitRange>[7:1]</bitRange>
                  </field>
                  <field>
                     <name>RS</name>
                     <description>Receive or Send
This bit-field specifies the next operation with addressed target CTA.SA.
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Receive data from target</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Transmit/send data to target</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CSTA</name>
               <description>Controller status
This register functions as a controller status register</description>
               <addressOffset>2052</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000020</resetValue>
               <fields>
                  <field>
                     <name>BUSBSY</name>
                     <description>Bus busy
Note:The bit changes based on the CCTRL.START and CCTRL.STOP conditions.</description>
                     <bitRange>[6:6]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The bus is busy.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The bus is idle.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IDLE</name>
                     <description>This field specifies whether I2C is idle or not</description>
                     <bitRange>[5:5]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The controller is idle.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The controller is not idle.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ARBLST</name>
                     <description>The filed specifies the arbitration status</description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The controller lost arbitration.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The controller won arbitration.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATACKN</name>
                     <description>This field contains Data acknowledge status</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The transmitted data was not acknowledged</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The transmitted data was acknowledged</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ADRACKN</name>
                     <description>This field reflects the address acknowledge status</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The transmitted address was not acknowledged</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The transmitted address was acknowledged</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERR</name>
                     <description>This field reflects the error status</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>An error occurred with the last operation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>No error was detected on the last operation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <description>This field reflects the I2C busy status
Note: The I2C controller requires four CLKSVT clock cycles to assert the BUSY status after I2C controller operation has been initiated through a write into CCTL register.
Hence after programming CCTL register, application is requested to wait for four CLKSVT clock cycles before issuing a controller status inquiry through a read from CSTA register. Any prior inquiry would result in wrong status being reported.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>The controller is busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>The controller is idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCTL</name>
               <description>Controller control
This register functions as a controller control register</description>
               <addressOffset>2052</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ACK</name>
                     <description>This field is to enable the data acknowledge.
Note:This bit-field must be cleared when the I2C bus controller requires no further data to be transmitted from the target transmitter.</description>
                     <bitRange>[3:3]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>The received data byte is acknowledged automatically by the controller</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>The received data byte is not acknowledged automatically by the controller</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STOP</name>
                     <description>This field is to set stop condition .
Note: This bit-field determines if the cycle stops at the end of the data cycle or continues on to a repeated start condition.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>The controller generates the stop condition</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>The controller does not generate the stop condition</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>START</name>
                     <description>This field is to set start or repeated start condition.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>The controller generates the start condition.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>The controller does not generate the start condition</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RUN</name>
                     <description>This field is to set the controller enable.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>The controller is enabled to transmit or receive data</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>The controller is disabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CDR</name>
               <description>Controller data
This register contains the data to be transmitted when in the controller transmit state and the data received when in the controller receive state.</description>
               <addressOffset>2056</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>When Read: Last RX Data is returned
When Written: Data is transferred during TX transaction</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTPR</name>
               <description>Controller timer period
This register specifies the period of the SCL clock.</description>
               <addressOffset>2060</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>TPR_7</name>
                     <description>Must be set to 0 to set CTPR.TPR. If set to 1, a write to CTPR.TPR will be ignored.</description>
                     <bitRange>[7:7]</bitRange>
                  </field>
                  <field>
                     <name>TPR</name>
                     <description>SCL clock period
This field specifies the period of the SCL clock.
SCL_PRD = 2*(1+TPR)*(SCL_LP + SCL_HP)*CLK_PRD, where:
SCL_PRD is the SCL line period (I2C clock).
TPR is the timer period register value (range of 1 to 127)
SCL_LP is the SCL low period (fixed at 6).
SCL_HP is the SCL high period (fixed at 4).
CLK_PRD is the CLKSVT period in ns.</description>
                     <bitRange>[6:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>CIMR</name>
               <description>Controller interrupt mask
This register controls whether a raw interrupt is promoted to a controller interrupt.</description>
               <addressOffset>2064</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>IM</name>
                     <description>Interrupt mask</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CRIS</name>
               <description>Controller raw interrupt status
This register shows the unmasked interrupt status.</description>
               <addressOffset>2068</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RIS</name>
                     <description>Raw interrupt status
This bit is cleared by writing 1 to CICR.IC bit.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CMIS</name>
               <description>Controller masked interrupt status
This register shows which interrupt is active (based on result from CRIS and CIMR registers).</description>
               <addressOffset>2072</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>MIS</name>
                     <description>Masked interrupt status
This bit is cleared by writing 1 to CICR.IC bit.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Masked interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Masked interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CICR</name>
               <description>Controller interrupt clear
This register clears the raw and masked interrupt.</description>
               <addressOffset>2076</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>IC</name>
                     <description>Interrupt clear </description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clear Interrupt
Writing 1 to this bit clears CRIS.RIS and CMIS.MIS.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCR</name>
               <description>Controller Configuration
This register configures the mode (Controller or Target) and sets the interface for test mode loopback.</description>
               <addressOffset>2080</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TFE</name>
                     <description>I2C target function enable
                        </description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Target mode enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Target mode disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFE</name>
                     <description>I2C controller function enable</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Controller mode enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Controller mode disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LPBK</name>
                     <description>I2C loopback</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Test mode (Loopback operation) enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Test mode (Loopback operation) disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>I2S</name>
         <description>I2S Audio DMA module supporting formats I2S, LJF, RJF and DSP

</description>
         <baseAddress>0x400C1000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>WCLKSRC</name>
               <description>This register configures the WCLK Source</description>
               <addressOffset>0</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>WCLKINV</name>
                     <description>This field Inverts WCLK source (pad or internal).</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INVERTED</name>
                           <value>0x1</value>
                           <description>Source is inverted</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_INTVERTED</name>
                           <value>0x0</value>
                           <description>Source is not intverted</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WBCLKSRC</name>
                     <description>This field selects WCLK/BCLK source for I2S.</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RESERVED</name>
                           <value>0x3</value>
                           <description>Not supported. Will give same WCLK as &#39;NONE&#39; (&#39;00&#39;)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INT</name>
                           <value>0x2</value>
                           <description>Internal WCLK generator, from module PRCM</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT</name>
                           <value>0x1</value>
                           <description>External WCLK generator, from pad</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NONE</name>
                           <value>0x0</value>
                           <description>None (&#39;0&#39;)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMACFG</name>
               <description>This register configures DMA buffer size</description>
               <addressOffset>4</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ENDFRMIDX</name>
                     <description>This field defines the length of the DMA buffer. Writing a non-zero value to this register field enables and initializes I2S. 
Note that before doing so, all other configuration must have been done, and INPTRNXT/OUTPTRNXT must have been loaded. </description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>DIRCFG</name>
               <description>This register configures the direction of data pins(AD0/AD1)</description>
               <addressOffset>8</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>AD1</name>
                     <description>The field configures the AD1 data pin direction</description>
                     <bitRange>[5:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RESERVED</name>
                           <value>0x3</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OUT</name>
                           <value>0x2</value>
                           <description>Output</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IN</name>
                           <value>0x1</value>
                           <description>Input</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Not in use (disabled)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AD0</name>
                     <description>The field configures the AD0 data pin direction</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RESERVED</name>
                           <value>0x3</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OUT</name>
                           <value>0x2</value>
                           <description>Output</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IN</name>
                           <value>0x1</value>
                           <description>Input</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Not in use (disabled)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>FMTCFG</name>
               <description>This register configures the serial interface format </description>
               <addressOffset>12</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000170</resetValue>
               <fields>
                  <field>
                     <name>DATADLY</name>
                     <description>This field configures the number of BCLK periods between a WCLK edge and MSB of the first word in a phase

Note: When 0, MSB of the next word will be output in the idle period between LSB of the previous word and the start of the next word. Otherwise logical 0 will be output until the data delay has expired.</description>
                     <bitRange>[15:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0xff</value>
                           <description>Max(255) BCLK periods - RJF format</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TWO</name>
                           <value>0x2</value>
                           <description>Two(Min) BCLK periods - RJF format</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONE</name>
                           <value>0x1</value>
                           <description>One BCLK periods - I2S and DSP formats</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <value>0x0</value>
                           <description>Zero BCLK periods - LJF and DSP formats</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MEMLEN32</name>
                     <description>This register configures the size of each word stored to or loaded from memory </description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>32-bit(one 32-bit access per sample)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>16-bit (one 16 bit access per sample)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SMPLEDGE</name>
                     <description>This field configures the sample edge/ transfer edge of data (and WCLK) on BCLK </description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>POSEDGE</name>
                           <value>0x1</value>
                           <description>Data is sampled on the positive edge and clocked out on the negative edge.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEGEDGE</name>
                           <value>0x0</value>
                           <description>Data is sampled on the negative edge and clocked out on the positive edge. </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DUALPHASE</name>
                     <description>This field selects between dual-phase or single-phase format</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DUALPHASE</name>
                           <value>0x1</value>
                           <description>Dual-phase: I2S, LJF and RJF formats</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SINGLEPHASE</name>
                           <value>0x0</value>
                           <description>Single-phase: DSP format</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WORDLEN</name>
                     <description>Number of bits per word (8-24):
In single-phase format, this is the exact number of bits per word. 
In dual-phase format, this is the maximum number of bits per word.

Values below 8 and above 24 give undefined behavior. Data written to memory is always aligned to 16 or 24 bits as defined by MEMLEN32. Bit widths that differ from this alignment will either be truncated or zero padded.
</description>
                     <bitRange>[4:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>WMASK0</name>
               <description>This register configures the word selection dit mask for data pin 0(AD0)</description>
               <addressOffset>16</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000003</resetValue>
               <fields>
                  <field>
                     <name>MASK</name>
                     <description>Bit-mask indicating valid channels in a frame on AD0.

In single-phase mode, each bit represents one channel, starting with LSB for the first word in the frame. A frame can contain up to 8 channels.  Channels that are not included in the mask will not be sampled and stored in memory, and clocked out as &#39;0&#39;.

In dual-phase mode, only the two LSBs are considered. For a stereo configuration, set both bits. For a mono configuration, set bit 0 only. In mono mode, only channel 0 will be sampled and stored to memory, and channel 0 will be repeated when clocked out.

In mono mode, only channel 0 will be sampled and stored to memory, and channel 0 will be repeated in the second phase when clocked out.

If all bits are zero, no input words will be stored to memory, and the output data lines will be constant &#39;0&#39;. This can be utilized when PWM debug output is desired without any actively used output pins.
</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>WMASK1</name>
               <description>This register configures the word selection dit mask for data pin 1(AD1)</description>
               <addressOffset>20</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000003</resetValue>
               <fields>
                  <field>
                     <name>MASK</name>
                     <description>Bit-mask indicating valid channels in a frame on AD1.

In single-phase mode, each bit represents one channel, starting with LSB for the first word in the frame. A frame can contain up to 8 channels.  Channels that are not included in the mask will not be sampled and stored in memory, and clocked out as &#39;0&#39;.

In dual-phase mode, only the two LSBs are considered. For a stereo configuration, set both bits. For a mono configuration, set bit 0 only. In mono mode, only channel 0 will be sampled and stored to memory, and channel 0 will be repeated when clocked out.

In mono mode, only channel 0 will be sampled and stored to memory, and channel 0 will be repeated in the second phase when clocked out.

If all bits are zero, no input words will be stored to memory, and the output data lines will be constant &#39;0&#39;. This can be utilized when PWM debug output is desired without any actively used output pins.</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>INPTRNXT</name>
               <description>This register configures DMA input buffer next pointer</description>
               <addressOffset>32</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PTR</name>
                     <description>Pointer to the first byte in the next DMA input buffer.

The read value equals the last written value until the currently used DMA input buffer is completed, and then becomes null when the last written value is transferred to the DMA controller to start on the next buffer. This event is signalized by IRQFLAGS.DMAIN. 

At startup, the value must be written once before and once after configuring the DMA buffer size in DMACFG.

The next pointer must be written to this register while the DMA function uses the previously written pointer. If not written in time, IRQFLAGS.PTRERR will be raised and all input pins will be disabled.</description>
                     <bitRange>[31:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>INPTR</name>
               <description>This register configures the DMA input buffer current pointer</description>
               <addressOffset>36</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PTR</name>
                     <description>Value of the DMA input buffer pointer currently used by the DMA controller. Incremented by 1 (byte) or 2 (word) for each AHB access.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>OUTPTRNXT</name>
               <description>This register configures DMA output buffer next pointer</description>
               <addressOffset>40</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PTR</name>
                     <description>Pointer to the first byte in the next DMA output buffer.

The read value equals the last written value until the currently used DMA output buffer is completed, and then becomes null when the last written value is transferred to the DMA controller to start on the next buffer. This event is signalized by IRQFLAGS.DMAOUT. 

At startup, the value must be written once before and once after configuring the DMA buffer size in DMACFG. At this time, the first two samples will be fetched from memory.

The next pointer must be written to this register while the DMA function uses the previously written pointer. If not written in time, IRQFLAGS.PTRERR will be raised and all output pins will be disabled.</description>
                     <bitRange>[31:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>OUTPTR</name>
               <description>This register configures DMA output buffer current pointer</description>
               <addressOffset>44</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PTR</name>
                     <description>Value of the DMA output buffer pointer currently used by the DMA controller Incremented by 1 (byte) or 2 (word) for each AHB access.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPCTL</name>
               <description>This register controls the samplestamp generator.</description>
               <addressOffset>52</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>OUTRDY</name>
                     <description>This field is low until the output pins are ready to be started by the samplestamp generator. When started (that is STMPOUTTRIG equals the WCLK counter) the bit goes back low.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INRDY</name>
                     <description>This field is low until the input pins are ready to be started by the samplestamp generator. When started (that is STMPINTRIG equals the WCLK counter) the bit goes back low.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STMPEN</name>
                     <description>This field configures the samplestamp generator. The samplestamp generator must only be enabled after it has been properly configured.
When cleared, all samplestamp generator counters and capture values are cleared.
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the samplestamp generator</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the samplestamp generator</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPXCNTCAPT0</name>
               <description>This register gives the captured XOSC counter value, capture channel 0</description>
               <addressOffset>56</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CAPTVALUE</name>
                     <description>The value of the samplestamp XOSC counter (STMPXCNT.CURRVALUE) last time an event was pulsed. This number corresponds to the number of 24 MHz clock cycles since the last positive edge of the selected WCLK.
The value is cleared when STMPCTL.STMPEN = 0.
Note: Due to buffering and synchronization, WCLK is delayed by a small number of BCLK periods and clk periods.
Note: When calculating the fractional part of the sample stamp, STMPXPER may be less than this bit field.
</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPXPER</name>
               <description>The register gives the XOSC period value</description>
               <addressOffset>60</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VALUE</name>
                     <description>The number of 24 MHz clock cycles in the previous WCLK period (that is -  the next value of the XOSC counter at the positive WCLK edge, had it not been reset to 0).
The value is cleared when STMPCTL.STMPEN = 0.
</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPWCNTCAPT0</name>
               <description>This register gives the captured WCLK counter value, capture channel 0</description>
               <addressOffset>64</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CAPT_VALUE</name>
                     <description>The value of the samplestamp WCLK counter (STMPWCNT.CURRVALUE) last time an event was pulsed. This number corresponds to the number of positive WCLK edges since the samplestamp generator was enabled (not taking modification through STMPWADD/STMPWSET into account).
The value is cleared when STMPCTL.STMPEN = 0.
</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPWPER</name>
               <description>This register configures WCLK counter period value</description>
               <addressOffset>68</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VALUE</name>
                     <description>This field defines when STMPWCNT is to be reset so number of WCLK edges are found for the size of the sample buffer. This is thus a modulo value for the WCLK counter. This number must correspond to the size of the sample buffer used by the system (that is the index of the last sample plus 1).</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPINTRIG</name>
               <description>This register configures WCLK counter trigger value for input pins</description>
               <addressOffset>72</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>INSTARTWCNT</name>
                     <description>This field configures the compare value used to start the incoming audio streams.
This bit field shall equal the WCLK counter value during the WCLK period in which the first input word(s) are sampled and stored to memory (that is the sample at the start of the very first DMA input buffer).

The value of this register takes effect when the following conditions are met:
- One or more pins are configured as inputs in DIRCFG.
- DMACFG has been configured for the correct buffer size, and at least 32 BCLK cycle ticks have happened.

Note: To avoid false triggers, this bit field should be set higher than STMPWPER.VALUE.
</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPOUTTRIG</name>
               <description>This register configures WCLK counter trigger value for output pins</description>
               <addressOffset>76</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>OUTSTARTWCNT</name>
                     <description>This field cofnigures the compare value used to start the outgoing audio streams.

This bit field must equal the WCLK counter value during the WCLK period in which the first output word(s) read from memory are clocked out (that is the sample at the start of the very first DMA output buffer).

The value of this register takes effect when the following conditions are met:
- One or more pins are configured as outputs in DIRCFG.
- DMACFG has been configured for the correct buffer size, and 32 BCLK cycle ticks have happened.
- 2 samples have been preloaded from memory (examine the OUTPTR register if necessary). 
Note: The memory read access is only performed when required, that is channels 0/1 must be selected in WMASK0/WMASK1.

Note: To avoid false triggers, this bit field should be set higher than STMPWPER.VALUE.
</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPWSET</name>
               <description>This register confiures WCLK counter set operation</description>
               <addressOffset>80</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VALUE</name>
                     <description>Sets the running WCLK counter equal to the written value. </description>
                     <bitRange>[15:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPWADD</name>
               <description>This register configures WCLK counter add operation</description>
               <addressOffset>84</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VALUEINC</name>
                     <description>Adds the written value to the running WCLK counter. If a positive edge of WCLK occurs at the same time as the operation, this will be taken into account.
To add a negative value, write &#34;STMPWPER.VALUE - value&#34;.
 </description>
                     <bitRange>[15:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPXPERMIN</name>
               <description>This register configures XOSC minimum period value
Minimum Value of STMPXPER</description>
               <addressOffset>88</addressOffset>
               <access>read-write</access>
               <resetValue>0x0000ffff</resetValue>
               <fields>
                  <field>
                     <name>VALUE</name>
                     <description>Each time STMPXPER is updated, the value is also loaded into this register, provided that the value is smaller than the current value in this register.
When written, the register is reset to 0xFFFF (65535), regardless of the value written.
The minimum value can be used to detect extra WCLK pulses (this registers value will be significantly smaller than STMPXPER.VALUE).
</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPWCNT</name>
               <description>This register gives the current value of WLCK counter</description>
               <addressOffset>92</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CURRVALUE</name>
                     <description>Current value of the WCLK counter</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>STMPXCNT</name>
               <description>This register gives the current value XOSC counter</description>
               <addressOffset>96</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CURRVALUE</name>
                     <description>Current value of the XOSC counter, latched when reading STMPWCNT.</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>IRQMASK</name>
               <description>Interrupt Mask Register

Selects mask states of the flags in IRQFLAGS that contribute to the I2S_IRQ event.</description>
               <addressOffset>112</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>XCNTCAPT</name>
                     <description>IRQFLAGS.XCNTCAPT interrupt mask</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAIN</name>
                     <description>IRQFLAGS.DMAIN interrupt mask</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAOUT</name>
                     <description>IRQFLAGS.DMAOUT interrupt mask</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WCLKTIMEOUT</name>
                     <description>IRQFLAGS.WCLKTIMEOUT interrupt mask</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSERR</name>
                     <description>IRQFLAGS.BUSERR interrupt mask</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WCLKERR</name>
                     <description>IRQFLAGS.WCLKERR interrupt mask
</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PTRERR</name>
                     <description>IRQFLAGS.PTRERR interrupt mask.
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the interrupt mask</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IRQFLAGS</name>
               <description>This registers gives the raw interrupt status</description>
               <addressOffset>116</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>XCNTCAPT</name>
                     <description>This interrupt is set when xcnt counter is captured either by events or software. 
Needs to be cleared by software.</description>
                     <bitRange>[6:6]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAIN</name>
                     <description>This interrupt is set when condition for this bit field event occurs (auto cleared when input pointer is updated - AIFINPTRNEXT), see description of AIFINPTRNEXT register for details.</description>
                     <bitRange>[5:5]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAOUT</name>
                     <description>This interrupt is set when condition for this bit field event occurs (auto cleared when output pointer is updated - OUTPTRNXT), see description of OUTPTRNXT register for details</description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WCLKTIMEOUT</name>
                     <description>Set when the sample stamp generator does not detect a positive WCLK edge for  65535 clk periods. This signalizes that the internal or external BCLK and WCLK generator source has been disabled.

The bit is sticky and may only be cleared by software (by writing &#39;1&#39; to IRQCLR.WCLKTIMEOUT).</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSERR</name>
                     <description>This interrupt set when a DMA operation is not completed in time (that is audio output buffer underflow, or audio input buffer overflow). 
This error requires a complete restart since word synchronization has been lost. The bit is sticky and may only be cleared by software (by writing &#39;1&#39; to IRQCLR.BUSERR).

Note that DMA initiated transactions to illegal addresses will not trigger an interrupt. The response to such transactions is undefined.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WCLKERR</name>
                     <description>This interrupt is set when: 
- An unexpected WCLK edge occurs during the data delay period of a phase.  Note unexpected WCLK edges during the word and idle periods of the phase are not detected.
-  In dual-phase mode, when two WCLK edges are less than 4 BCLK cycles apart.
-  In single-phase mode, when a WCLK pulse occurs before the last channel.
This error requires a complete restart since word synchronization has been lost. The bit is sticky and may only be cleared by software (by writing &#39;1&#39; to IRQCLR.WCLKERR).</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PTRERR</name>
                     <description>This interrupt set when INPTRNXT or OUTPTRNXT has not been loaded with the next block address in time. 
This error requires a complete restart since word synchronization has been lost. The bit is sticky and may only be cleared by software (by writing &#39;1&#39; to IRQCLR.PTRERR).
</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occured</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Interrupt did not occur</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
