               <fields>
                  <field>
                     <name>SRC</name>
                     <description>Select audio frequency clock source

Software should make sure that proper clock is selected before enabling the audio IP.</description>
                     <bitRange>[2:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLKEXT</name>
