                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MODE_APP</name>
                           <value>0xc0</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_FAULT_HANDLER</name>
                           <value>0xbf</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_FAIL_APPTRANSFER</name>
                           <value>0xbe</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_FAIL_EXECUTION_CONTEXT</name>
                           <value>0xbd</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_CMD_PROCESSING</name>
                           <value>0xbc</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_CMD_IDLE</name>
                           <value>0xbb</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_STARTED</name>
                           <value>0xba</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLDR_WAITLOOP_DBGPROBE</name>
                           <value>0x81</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MODE_BLDR</name>
                           <value>0x80</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_FAULT_HANDLER</name>
                           <value>0x3f</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_FAIL_SRAM_REPAIR</name>
                           <value>0x3e</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_WAITLOOP_DBGPROBE</name>
                           <value>0x38</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_EXITED_SACI</name>
                           <value>0x37</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_WAIT_SWD_DISCONNECT</name>
                           <value>0x36</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_EXITED_SECURE_BOOT</name>
                           <value>0x35</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_ENTERED_SECURE_BOOT</name>
                           <value>0x34</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
