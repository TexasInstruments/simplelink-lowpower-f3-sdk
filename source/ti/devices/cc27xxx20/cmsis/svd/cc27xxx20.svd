                  </field>
                  <field>
                     <name>PESETUPTIME</name>
                     <description>Program/Erase Setup Time
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TWOXFUNCTIONAL</name>
                           <value>0x1</value>
                           <description>Use 2x the hard-wired (functional) time value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FUNCTIONAL</name>
                           <value>0x0</value>
                           <description>Use hard-wired (Functional) timer value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTEXECZCTL</name>
               <description>DFT EXECUTEZ control register.  This register allows direct control of the
EXECUTEZ to bank and pump for test.
This register is only writable when DFTEN.ENABLE is set.
This register is blocked for writes after a 1 is written to the CMDEXEC
register and prior to STATCMD.DONE being set by the flash wrapper
hardware.</description>
               <addressOffset>1292</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000002</resetValue>
               <fields>
                  <field>
                     <name>EXEZ_OVR</name>
                     <description>Override value to be applied to EXECUTEZ</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ONE</name>
                           <value>0x1</value>
                           <description>Set EXECUTEZ to 1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <value>0x0</value>
                           <description>Set EXECUTEZ to 0</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXEZOVREN</name>
                     <description>Enable override of EXECUTEZ
Note that when this bit is set, the flash wrapper has control of the bank pins.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTPCLKTESTCTL</name>
               <description>DFT Pump Clock Test Control Register.  This register controls hardware features
that allow the pump clock to be characterized for trim development.
This register is only writable when DFTEN.ENABLE is set.
This register is blocked for writes after a 1 is written to the CMDEXEC
register and prior to STATCMD.DONE being set by the flash wrapper
hardware.</description>
               <addressOffset>1296</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ENABLE</name>
                     <description>Enable the state machine which sequences measurement of pump clock 
frequency.
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTPCLKTESTSTAT</name>
               <description>DFT Pump Clock Test Status Register.  This register shows status reported by the
hardware features that allow the pump clock to be characterized for trim
development.
This register is only writable when DFTEN.ENABLE is set.</description>
               <addressOffset>1300</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CLOCKCNT</name>
                     <description>Indicates the core clock count captured during the pump clock measurement.</description>
                     <bitRange>[15:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xfff</value>
                           <description>Maximum count value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Minimum count value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <description>Indicates that a pump clock measurement is in progress.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INPROGRESS</name>
                           <value>0x1</value>
                           <description>Indicates test in progress</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COMPLETE</name>
                           <value>0x0</value>
                           <description>Indicates test complete</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTDATARED0</name>
               <description>DFT Redundancy Data Register 0
This register is used when testing the redundant columns in the flash.  It acts
as an extension of the CMDDATA* registers.  The bits in this register correspond
to flash data word register 0.
In addition, this register is used to aggregate masking for bits that do not
require additional program pulses during program operations.  The original
data written to this register will be lost during program command execution.

Use cases for this register are as follows:
1)	Program - Contains the data to be programmed.
2)	Erase - Not used.
3)	Read Verify - Contains data to be verified.

This register is only writable when DFTEN.ENABLE is set.
This register is blocked for writes after a 1 is written to the CMDEXEC
register and prior to STATCMD.DONE being set by the flash wrapper
hardware.</description>
               <addressOffset>1344</addressOffset>
               <access>read-write</access>
               <resetValue>0x0000000f</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Data for redundant bits</description>
                     <bitRange>[3:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTPUMPCTL</name>
               <description>DFT Pump Control Register
This allows some configuration of pump parameters during test.
This register is only writable when DFTEN.ENABLE is set.
This register is blocked for writes after a 1 is written to the CMDEXEC
register and prior to STATCMD.DONE being set by the flash wrapper
hardware.</description>
               <addressOffset>1376</addressOffset>
               <access>read-write</access>
               <resetValue>0x00001000</resetValue>
               <fields>
                  <field>
                     <name>IREFEVCTL</name>
                     <description>IREFEV control IREFVRD, REFTC, IREFCONST, IREFCCOR blocks in IREFEV</description>
                     <bitRange>[18:16]</bitRange>
                  </field>
                  <field>
                     <name>CONFIGPMP</name>
                     <description>Pump configuration control. LP, HP operation</description>
                     <bitRange>[15:12]</bitRange>
                  </field>
                  <field>
                     <name>SSEN</name>
                     <description>Dither control for oscillator
Enumeration:
0: Disable Dither
1: Enable Dither
</description>
                     <bitRange>[9:9]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PUMPCLKEN</name>
                     <description>Allows direct control of the pump oscillator which is used to generate pumpclk.
Normally, enable/disable of pumpclk is under flash wrapper state machine
control.  This bit allows system to enable the clock independently.</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Force pump clock oscillator to be enabled.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HWCTL</name>
                           <value>0x0</value>
                           <description>Allow pump clock oscillator to be controlled by hardware.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TCR</name>
                     <description>TCR test mode to be applied to the pump</description>
                     <bitRange>[6:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0x7f</value>
                           <description>Maximum value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Minimum value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DFTBANKCTL</name>
               <description>DFT Bank Control Register
This allows some configuration of bank parameters during test.
This register is only writable when DFTEN.ENABLE is set.
This register is blocked for writes after a 1 is written to the CMDEXEC
register and prior to STATCMD.DONE being set by the flash wrapper
hardware.</description>
               <addressOffset>1380</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000100</resetValue>
               <fields>
                  <field>
                     <name>TEZ</name>
                     <description>When set, TEZ is asserted to the flash banks.  Which banks get the asserted 
signal is determined by the BANKSELECT field in CMDCTL.
0x0 Do no assert TEZ
0x1 Assert TEZ</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NEGATE</name>
                           <value>0x1</value>
                           <description>Do not assert TEZ</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ASSERT</name>
                           <value>0x0</value>
                           <description>Assert TEZ</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TCR</name>
                     <description>TCR test mode to be applied to the bank</description>
                     <bitRange>[6:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0x7f</value>
                           <description>Maximum value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Minimum value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
