      <peripheral>
         <name>CANFD</name>
         <description>IPXACT generated on 6/2/2017 at 11:21 by the IPXCEL-to-IPXACT Converter Script v3.1</description>
         <baseAddress>0x400D0000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
