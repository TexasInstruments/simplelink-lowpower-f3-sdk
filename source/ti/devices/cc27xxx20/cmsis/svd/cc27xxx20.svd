            <register>
               <name>HFTRACKCTL</name>
               <description>High frequency tracking loop control</description>
               <addressOffset>164</addressOffset>
               <access>read-write</access>
               <resetValue>0x00400000</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <description>Enable tracking loop.</description>
                     <bitRange>[31:31]</bitRange>
                  </field>
                  <field>
                     <name>DSMBYP</name>
                     <description>Bypass Delta-Sigma-Modulation of fine trim.</description>
                     <bitRange>[30:30]</bitRange>
                  </field>
                  <field>
                     <name>UNDERCLK</name>
                     <description>When the HFOSC tracking loop is not running, this bitfield can be used to set the condition to automatically lower the HFOSC frequency. This will prevent frequency drift that may lead to SOC instability.</description>
                     <bitRange>[29:28]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BOTH</name>
                           <value>0x3</value>
                           <description>Temperature event from Batmon or Timer event</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BATMON</name>
                           <value>0x2</value>
                           <description>Temperature event from Batmon</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TIMER</name>
                           <value>0x1</value>
                           <description>Timer event</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REFCLK</name>
                     <description>Select the reference clock for the tracking loop.
Change only while the tracking loop is disabled.</description>
                     <bitRange>[27:26]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>GPI</name>
                           <value>0x2</value>
                           <description>Select GPI as reference clock.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LRF</name>
                           <value>0x1</value>
                           <description>Select LRF reference clock.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HFXT</name>
                           <value>0x0</value>
                           <description>Select HFXT as reference clock.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RATIO</name>
                     <description>Reference clock ratio. Ratio format is 2b.24b

RATIO = 24MHz / (2*reference-frequency) * 2^24
Commonly used reference clock frequencies are provided as enumerations.
</description>
                     <bitRange>[25:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>REF4M</name>
                           <value>0x3000000</value>
                           <description>Use for 4MHz reference clock</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REF8M</name>
                           <value>0x1800000</value>
                           <description>Use for 8MHz Reference clock</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REF48M</name>
                           <value>0x400000</value>
                           <description>Use for 48MHz reference clock</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
