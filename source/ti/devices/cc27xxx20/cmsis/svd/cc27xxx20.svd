                     <name>LFCLKGOOD</name>
                     <description>LF clock good.

Indicates that the LF clock is good, according to the configuration in LFQUALCTL.</description>
                     <bitRange>[10:10]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>LFINCUPD</name>
                     <description>LFINC updated.

