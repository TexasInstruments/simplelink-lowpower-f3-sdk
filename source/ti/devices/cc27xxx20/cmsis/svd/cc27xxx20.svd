               <name>MCAN_TXBCF</name>
               <description>MCAN Tx Buffer Cancellation Finished</description>
               <addressOffset>220</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
