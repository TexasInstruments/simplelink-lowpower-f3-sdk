                     <name>MAJREV</name>
                     <description>Major rev of the IP</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor rev of the IP</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKCTL</name>
               <description>Systimer Output Event Control Register.

Controls the functional clock gates for the individual sub-modules.</description>
               <addressOffset>4</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>IQRAM</name>
                     <description>Enable the clock to the demodulator</description>
                     <bitRange>[14:14]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>The bit is 1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>The bit is 0</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DEM</name>
                     <description>Enable the clock to the demodulator. The modem will request this clock automatically. This bit is to force the clock to be free running</description>
                     <bitRange>[13:13]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clock is requested</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Clock not requested</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MOD</name>
