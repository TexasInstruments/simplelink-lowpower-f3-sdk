                  </field>
               </fields>
            </register>
            <register>
               <name>DESCEX</name>
               <description>This register describes the configuration of IOC.</description>
               <addressOffset>4</addressOffset>
               <access>read-only</access>
               <resetValue>0x0000f3e7</resetValue>
               <fields>
                  <field>
                     <name>NUMDTBIO</name>
                     <description>Number of DTB IOs supported. Total DTB IOs supported is NUMDTBIO value +1.</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0xf</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NUMHDIO</name>
                     <description>Number of HD IOs supported. Total HD IOs supported is NUMHDIO value +1.</description>
                     <bitRange>[11:7]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0x1f</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
