                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXTREF</name>
                           <value>0x1</value>
                           <description>External reference from AREF+/AREF- pins</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VDDS</name>
                           <value>0x0</value>
                           <description>VDDS reference</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ASCSTIME</name>
