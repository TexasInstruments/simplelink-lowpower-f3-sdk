            <register>
               <name>EVTCFG</name>
               <description>Event configuration. This register is used to select DIO for IOC to publish event on AON event fabric. It also contains enable bit that is used to mask the event and event flag bit.</description>
               <addressOffset>3080</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>EVTIFG</name>
                     <description>Event flag. It is set when edge is detected on selected DIO.
Note: The edge detector flop is cleared for the selected DIO when EVTIFG is cleared by software.</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Clear</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EVTEN</name>
                     <description>Enables IOC to publish event on AON event fabric when EVTIFG is set. </description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIOSEL</name>
                     <description>This is used to select DIO for event generation. For example, DIOSEL = 0x0 selects DIO0 and DIOSEL = 0x8 selects DIO8.</description>
                     <bitRange>[5:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAXIMUM</name>
                           <value>0x3f</value>
                           <description>Maximum value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MINIMUM</name>
                           <value>0x0</value>
                           <description>Minimum value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
