                           <value>0x1</value>
                           <description>Mailbox is Full</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EMTY</name>
                           <value>0x0</value>
                           <description>Mailbox is Empty</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB1IN</name>
