                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Interrupt occurred</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
