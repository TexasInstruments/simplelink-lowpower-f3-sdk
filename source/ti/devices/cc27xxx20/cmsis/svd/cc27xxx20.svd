            <register>
               <name>VREFSTA</name>
               <description>VREF Status Register.
This register contains VREF settling status.</description>
               <addressOffset>180</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>GOOD</name>
                     <description>VREF settling / good status.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OK</name>
                           <value>0x1</value>
                           <description>VREF voltage is good.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_OK</name>
                           <value>0x0</value>
                           <description>VREF voltage is not good.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>PMUD</name>
         <description>Digital control signals for VDDR regulator and Battery Monitor</description>
         <baseAddress>0x40006000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CTL</name>
               <description>Control
General Configuration of BATMON

</description>
               <addressOffset>0</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000004</resetValue>
               <fields>
                  <field>
                     <name>HYST_EN</name>
                     <description>Enables hysteresis on both battery and temperature measurements.</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CALC_EN</name>
                     <description>Configuration of the calculation block that converts the digital battery/temperature level to a Volt/Celsius value.

</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Calculation enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Calculation disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MEAS_EN</name>
                     <description>Configuration of the measurement block that interfaces with the analog domain.

</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Measurements enabled (battery voltage and temperature)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Measurements disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MEASCFG</name>
               <description>Internal. Only to be used through TI provided API.</description>
               <addressOffset>4</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PER</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>_32CYC</name>
                           <value>0x3</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>_16CYC</name>
                           <value>0x2</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>_8CYC</name>
                           <value>0x1</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CONT</name>
                           <value>0x0</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>BAT</name>
               <description>Last Measured Battery Voltage

This register should be read when BATUPD.STA = 1

</description>
               <addressOffset>40</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>INT</name>
                     <description>Integer part:

0x0: Battery voltage = 0V + fractional part
...
0x3: Battery voltage = 3V + fractional part
0x4: Battery voltage = 4V + fractional part

</description>
                     <bitRange>[10:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>FRAC</name>
                     <description>Fractional part, standard binary fractional encoding.

0x00: .0V
...
0x20: 1/8 = .125V
0x40: 1/4 = .25V
0x80: 1/2 = .5V
...
0xA0: 1/2 + 1/8 = .625V
...
0xFF: 1/2 + 1/4 + 1/8 + ... + 1/256 = 0.99V

</description>
                     <bitRange>[7:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>BATUPD</name>
               <description>Battery Update

Indicates BAT Updates

</description>
               <addressOffset>44</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STA</name>
                     <description>Battery update status. Write 1 to clear the status.

</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UPD</name>
                           <value>0x1</value>
                           <description>New battery voltage present</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOUPD</name>
                           <value>0x0</value>
                           <description>No update since last clear</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMP</name>
               <description>Last measured Temperature in Degree Celsius

This register should be read when TEMPUPD.STA = 1.

</description>
               <addressOffset>48</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>INT</name>
                     <description>Integer part of temperature value  (signed) 
Total value = INT + FRAC
2&#39;s complement encoding

0x100: Min value (-256°C)
0x1D8: -40°C
0x1FF: -1°C
0x00: 0°C
0x1B: 27°C
0x55: 85°C
0xFF: Max value (255°C)

</description>
                     <bitRange>[16:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>FRAC</name>
                     <description>Fractional part of temperature value.
Total value = INT + FRAC
The encoding is an extension of the 2&#39;s complement encoding.

00: 0.0°C
01: 0.25°C
10: 0.5°C
11: 0.75°C

For example:
000000001,00 = ( 1+0,00) =  1,00
000000000,11 = ( 0+0,75) =  0,75
000000000,10 = ( 0+0,50) =  0,50
000000000,01 = ( 0+0,25) =  0,25
000000000,00 = ( 0+0,00) =  0,00
111111111,11 = (-1+0,75) = -0,25
111111111,10 = (-1+0,50) = -0,50
111111111,01 = (-1+0,25) = -0,75
111111111,00 = (-1+0,00) = -1,00
111111110,11 = (-2+0,75) = -1,25

</description>
                     <bitRange>[7:6]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEMPUPD</name>
               <description>Temperature Update

Indicates TEMP Updates

</description>
               <addressOffset>52</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STA</name>
                     <description>Temperature update status. Write 1 to clear the status.
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UPD</name>
                           <value>0x1</value>
                           <description>New temperature value present</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOUPD</name>
                           <value>0x0</value>
                           <description>No temperature update since last clear</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>EVENTMASK</name>
               <description>Event Mask</description>
               <addressOffset>72</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TEMP_UPDATE_MASK</name>
                     <description>1: EVENT.TEMP_UPDATE contributes to combined event from BATMON
0: EVENT.TEMP_UPDATE does not contribute to combined event from BATMON

</description>
                     <bitRange>[5:5]</bitRange>
                  </field>
                  <field>
                     <name>BATT_UPDATE_MASK</name>
                     <description>1: EVENT.BATT_UPDATE contributes to combined event from BATMON
0: EVENT.BATT_UPDATE does not contribute to combined event from BATMON

</description>
                     <bitRange>[4:4]</bitRange>
                  </field>
                  <field>
                     <name>TEMP_BELOW_LL_MASK</name>
                     <description>1: EVENT.TEMP_BELOW_LL contributes to combined event from BATMON
0: EVENT.TEMP_BELOW_LL does not contribute to combined event from BATMON

</description>
                     <bitRange>[3:3]</bitRange>
                  </field>
                  <field>
                     <name>TEMP_OVER_UL_MASK</name>
                     <description>1: EVENT.TEMP_OVER_UL contributes to combined event from BATMON
0: EVENT.TEMP_OVER_UL does not contribute to combined event from BATMON

</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>BATT_BELOW_LL_MASK</name>
                     <description>1: EVENT.BATT_BELOW_LL contributes to combined event from BATMON
0: EVENT.BATT_BELOW_LL does not contribute to combined event from BATMON

</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>BATT_OVER_UL_MASK</name>
                     <description>1: EVENT.BATT_OVER_UL contributes to combined event from BATMON
0: EVENT.BATT_OVER_UL does not contribute to combined event from BATMON

</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>EVENT</name>
               <description>Event</description>
               <addressOffset>76</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TEMP_UPDATE</name>
                     <description>Alias to TEMPUPD.STA

</description>
                     <bitRange>[5:5]</bitRange>
                  </field>
                  <field>
                     <name>BATT_UPDATE</name>
                     <description>Alias to BATUPD.STA

</description>
                     <bitRange>[4:4]</bitRange>
                  </field>
                  <field>
                     <name>TEMP_BELOW_LL</name>
                     <description>Read:
1: Temperature level is below the lower limit set by TEMPLL.
0: Temperature level is not below the lower limit set by TEMPLL.
Write:
1: Clears the flag
0: No change in the flag

</description>
                     <bitRange>[3:3]</bitRange>
                  </field>
                  <field>
                     <name>TEMP_OVER_UL</name>
                     <description>Read:
1: Temperature level is above the upper limit set by TEMPUL.
0: Temperature level is not above the upper limit set by TEMPUL.
Write:
1: Clears the flag
0: No change in the flag

</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>BATT_BELOW_LL</name>
                     <description>Read:
1: Battery level is below the lower limit set by BATTLL.
0: Battery level is not below the lower limit set by BATTLL.
Write:
1: Clears the flag
0: No change in the flag

</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>BATT_OVER_UL</name>
                     <description>Read:
1: Battery level is above the upper limit set by BATTUL.
0: Battery level is not above the upper limit set by BATTUL.
Write:
1: Clears the flag
0: No change in the flag

</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>BATTUL</name>
               <description>Battery Upper Limit

Total battery voltage = INT + FRAC
It is a sum of integer and fractional parts</description>
               <addressOffset>80</addressOffset>
               <access>read-write</access>
               <resetValue>0x000007ff</resetValue>
               <fields>
                  <field>
                     <name>INT</name>
                     <description>Integer part:
Total battery voltage = INT + FRAC (integer and fractional part)

0x0: Battery voltage = 0V + fractional part
...
0x3: Battery voltage =  3V + fractional part
0x4: Battery voltage =  4V + fractional part

</description>
                     <bitRange>[10:8]</bitRange>
                  </field>
                  <field>
                     <name>FRAC</name>
                     <description>Fractional part, standard binary fractional encoding.

0x00: .0V
...
0x20: 1/8 = .125V
0x40: 1/4 = .25V
0x80: 1/2 = .5V
...
0xA0: 1/2 + 1/8 = .625V
...
0xFF: 1/2 + 1/4 + 1/8 + ... + 1/256 = 0.99V

</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>BATTLL</name>
               <description>Battery Lower Limit

Total battery voltage = INT + FRAC
It is a sum of integer and fractional parts</description>
               <addressOffset>84</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>INT</name>
                     <description>Integer part:
Total battery voltage = INT + FRAC (integer and fractional part)

0x0: Battery voltage = 0V + fractional part
...
0x3: Battery voltage =  3V + fractional part
0x4: Battery voltage =  4V + fractional part

</description>
                     <bitRange>[10:8]</bitRange>
                  </field>
                  <field>
                     <name>FRAC</name>
                     <description>Fractional part, standard binary fractional encoding.

0x00: .0V
...
0x20: 1/8 = .125V
0x40: 1/4 = .25V
0x80: 1/2 = .5V
...
0xA0: 1/2 + 1/8 = .625V
...
0xFF: 1/2 + 1/4 + 1/8 + ... + 1/256 = 0.99V

</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
