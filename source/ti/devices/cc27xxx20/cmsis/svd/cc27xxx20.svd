            <register>
               <name>HFXTCTL</name>
               <description>HFXT Control Register.
This register controls features to turn on/off HFXT automatically.</description>
               <addressOffset>168</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>LFCAL</name>
                     <description>LF Calibration Enable.
Turn on/off HFXT periodically to perform LF oscillator calibration. 
LF oscillator period and measurement time is configured through LFCAL.</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>HFXT on/off periodically for LF calibration is enabled.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>HFXT on/off periodically for LF calibration is disabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AUTO</name>
                     <description>Turn on/off HFXT during STANDBY entry/exit.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>HFXT turned off when entring STANDBY and turned on when leaving STANDBY.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>HFXT is neither turned on/off during STANDBY entry/exit</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFCAL</name>
               <description>Low Frequency Calibration Register.
This register contains the period and measurement time setting used for LF oscillator calibration.
The LF calibartion feature is enabled through HFXTCTL.LFCAL.</description>
               <addressOffset>172</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>QUAL</name>
                     <description>CKM qualifier configuration. 
Used to qualify that LF calibration is completed before HFXT is request off.</description>
                     <bitRange>[31:31]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable CKM qualifier</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable CKM qualifier</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MEAS</name>
                     <description>LFCAL measurment time, given in number of 32kHz periods.</description>
                     <bitRange>[23:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0xff</value>
                           <description>Maximum LFCAL measurment time</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PER</name>
                     <description>LFCAL period time, given in number of 256 * 32kHz periods.
</description>
                     <bitRange>[7:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0xff</value>
                           <description>Maximum LFCAL period time</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>VREFCFG</name>
               <description>Internal. Only to be used through TI provided API.</description>
               <addressOffset>176</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000011</resetValue>
