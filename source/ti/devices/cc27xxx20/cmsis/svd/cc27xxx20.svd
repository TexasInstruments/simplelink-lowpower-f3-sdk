                  </field>
               </fields>
            </register>
            <register>
               <name>AONRSTA1</name>
               <description>AON Register Status 1.
This register contains the general purpose AON flags for SW, and is updated through AONRSET1.FLAG and AONRCLR1.FLAG.
The register is only reset on a POR event.
</description>
               <addressOffset>60</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VDDIOPGIO</name>
                     <description>VDDIO power good.
Controls the I/O pads on the VDDIO segment.</description>
                     <bitRange>[20:20]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>FLAG</name>
                     <description>State of the AON register flags</description>
                     <bitRange>[17:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>AONRSET1</name>
               <description>AON Register Set 1.
This register sets the AON flags that can be read through AONRSTA1.FLAG.</description>
               <addressOffset>64</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VDDIOPGIO</name>
                     <description>Write 1 to set AONRSTA1.VDDIOPGIO.</description>
                     <bitRange>[20:20]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set flag</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLAG</name>
                     <description>Write 1 to set AONRSTA1.FLAG</description>
                     <bitRange>[17:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ALL_SET</name>
                           <value>0x3ffff</value>
                           <description>Set all flags</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No flags changed status</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AONRCLR1</name>
               <description>AON register clear 1

Clear the AON flags that can be read through AONRSTA1.FLAG</description>
               <addressOffset>68</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VDDIOPGIO</name>
                     <description>Write 1 to clear AONRSTA1.VDDIOPGIO.</description>
                     <bitRange>[20:20]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear flag</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLAG</name>
                     <description>Write 1 to clear AONRSTA1.FLAG</description>
                     <bitRange>[17:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ALL_CLR</name>
                           <value>0x3ffff</value>
                           <description>Clear all flags</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No flags changed status</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DELTA</name>
               <description>Delta Time Register.
This register contains the measured delta time during wakeup from STANDBY mode.</description>
               <addressOffset>76</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SLWP</name>
                     <description>Slow part.
States which of HFXT ready or SW ready that completed first during wakeup from STANDBY mode.</description>
                     <bitRange>[31:30]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INVALID3</name>
                           <value>0x3</value>
                           <description>No valid measurement available</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HFXT</name>
                           <value>0x2</value>
                           <description>HFXT ready set after SW ready (SWSTMP.SWRDY)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SVT</name>
                           <value>0x1</value>
                           <description> HFXT ready set before SW ready (SWSTMP.SWRDY)
</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INVALID0</name>
                           <value>0x0</value>
                           <description>No valid measurement available</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TIME</name>
                     <description>Delta time.
Measured time in us between SWSTMP.SWRDY and HFXT ready. 
This is a always a positive number, and SLWP is used to determine which event occurred first.
Measurement is enabled when PREPUCTL.WUTIMEN is set.
</description>
                     <bitRange>[11:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>WUTIME</name>
               <description>WakeUp Time Register.
This register contains the measured wakeup times from STANDBY mode.</description>
               <addressOffset>80</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DIGWU</name>
                     <description>Digital wakeup time. 
Gives the time (in us) from HFSOC is running until CPU execution starts.
Measurement is enabled when PREPUCTL.WUTIMEN is set. </description>
                     <bitRange>[23:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>HFXTWU</name>
                     <description>HFXT wakeup time.
Gives the time (in us) from HFSOC is running until HFXT auto enable is triggered.
Measurement is enabled when PREPUCTL.WUTIMEN is set.</description>
                     <bitRange>[7:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>PREPUCTL</name>
               <description>Pre Power-Up Control Register.
This register contains settings and control for pre-powerup, STANDBY and wakeup measurements.</description>
               <addressOffset>84</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PREPUEN</name>
                     <description>Pre powerup Enable.
When this bit is set, the device will start the wakeup process in advance of the RTC wakeup event.
This to start HFXT settling earlier, so that HFXT can be ready when SW is ready.
Note that HFXTCTL.AUTO must be enabled to turn on HFXT.</description>
                     <bitRange>[31:31]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable pre-powerup</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable pre-powerup</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WUTIMEN</name>
                     <description>Wakeup time measurement enable.
When set will enable WUTIME.DIGWU,  WUTIME.HFXTWU and DELTA.TIME time measurements.</description>
                     <bitRange>[30:30]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable wakeup time measurement </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable wakeup time measurement </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CONS</name>
                     <description>Conservative pre-wakeup time.
When PREPUEN is set, the device will start the wakeup process in advance of the RTC wakeup event.
This field will give the conservative time in advance of a RTC event. Conservative value is used if a temperature change has been detected since STANDBY mode was entered.
The time unit for the value is 8us.</description>
                     <bitRange>[15:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0xfe</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MIN</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOM</name>
                     <description>Nominal pre-wakeup time.
When PREPUEN is set, the device will start the wakeup process in advance of the RTC wakeup event.
This field will give the nominal time in advance of a RTC event. Nominal value is used if no temperature change has been detected since STANDBY mode was entered.
The time unit for the value is 8us.</description>
                     <bitRange>[7:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0xfe</value>
                           <description>Highest possible value</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MIN</name>
                           <value>0x0</value>
                           <description>Smallest value</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SWSTMP</name>
               <description>SW Time Stamp Register.
This register is used to set the SW time stamp for the delta time measurement.</description>
               <addressOffset>88</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SWRDY</name>
                     <description>SW ready.
Set by SW to indicate when SW is ready. Used to measure DELTA.TIME and DELTA.SLWP.
This bit is auto-cleared by HW.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set SW ready time stamp. Auto-cleared by HW</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>No effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
