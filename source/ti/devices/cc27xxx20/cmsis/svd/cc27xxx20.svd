            </register>
            <register>
               <name>HFOSCCTL</name>
               <description>Internal. Only to be used through TI provided API.</description>
               <addressOffset>128</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PW</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[31:24]</bitRange>
                     <access>write-only</access>
                  </field>
                  <field>
                     <name>FORCEOFF</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>QUALBYP</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>HFXTCTL</name>
               <description>High frequency crystal control</description>
               <addressOffset>132</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>AMPOVR</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[31:31]</bitRange>
                  </field>
                  <field>
                     <name>BIASEN</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[26:26]</bitRange>
                  </field>
                  <field>
                     <name>LPBUFEN</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[25:25]</bitRange>
                  </field>
                  <field>
                     <name>INJECT</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[24:24]</bitRange>
                  </field>
                  <field>
                     <name>QUALBYP</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[23:23]</bitRange>
                  </field>
                  <field>
                     <name>QUALDLY</name>
                     <description>Skip potentially unstable clock cycles after enabling HFXT.
Number of cycles skipped is 8*QUALDLY.</description>
                     <bitRange>[19:8]</bitRange>
                  </field>
                  <field>
                     <name>TCXOMODE</name>
                     <description>Temperature compensated crystal oscillator mode.

Set this bit if a TXCO is connected.</description>
                     <bitRange>[7:7]</bitRange>
                  </field>
                  <field>
                     <name>TCXOTYPE</name>
                     <description>Type of temperature compensated crystal used.

Only has effect if TCXOMODE is set.</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CMOS</name>
                           <value>0x1</value>
                           <description>Use with CMOS TCXO</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLIPPEDSINE</name>
                           <value>0x0</value>
                           <description>Use with clipped-sine TCXO</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AUTOEN</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>HPBUFEN</name>
                     <description>High performance clock buffer enable.

This bit controls the clock output for the RF PLL.
It is required for radio operation.</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFOSCCTL</name>
               <description>Low frequency oscillator control</description>
               <addressOffset>140</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <description>LFOSC enable</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFXTCTL</name>
               <description>Low frequency crystal control</description>
               <addressOffset>144</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>LEAKCOMP</name>
                     <description>Leakage compensation control</description>
                     <bitRange>[14:13]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>OFF</name>
                           <value>0x3</value>
                           <description>No leakage compensation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HALF</name>
                           <value>0x1</value>
                           <description>Half leakage compensation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FULL</name>
                           <value>0x0</value>
                           <description>Full leakage compensation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUFBIAS</name>
                     <description>Control the BIAS current of the input amp in LP buffer</description>
                     <bitRange>[12:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MAX</name>
                           <value>0x1</value>
                           <description>Maximum bias current: 50nA</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MIN</name>
                           <value>0x0</value>
                           <description>Minimum bias current: 25nA</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AMPBIAS</name>
                     <description>Adjust current mirror ratio into oscillator core. This value is depending on crystal and is set by FW. This field uses a 2&#39;s complement encoding.</description>
                     <bitRange>[11:8]</bitRange>
                  </field>
                  <field>
                     <name>BIASBOOST</name>
                     <description>Boost oscillator amplitude

This value depends on the crystal and needs to be configured by Firmware.</description>
                     <bitRange>[7:6]</bitRange>
                  </field>
                  <field>
                     <name>REGBIAS</name>
                     <description>Regulation loop bias resistor value

This value depends on the crystal and needs to be configured by Firmware.</description>
                     <bitRange>[5:4]</bitRange>
                  </field>
                  <field>
                     <name>HPBUFEN</name>
                     <description>Control the buffer used. In normal operation, low-power buffer is used in all device modes. The high-performance buffer is only used for test purposes.
</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>AMPREGMODE</name>
                     <description>Amplitude regulation mode</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LOOPDIS</name>
                           <value>0x1</value>
                           <description>Amplitude control loop disabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOOPEN</name>
                           <value>0x0</value>
                           <description>Amplitude control loop enabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>LFXT enable</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFQUALCTL</name>
               <description>Low frequency clock qualification control</description>
               <addressOffset>148</addressOffset>
               <access>read-write</access>
               <resetValue>0x00002064</resetValue>
               <fields>
                  <field>
                     <name>MAXERR</name>
                     <description>Maximum LFCLK period error.

Value given in microseconds, 3 integer bits + 3 fractional bits.</description>
                     <bitRange>[13:8]</bitRange>
                  </field>
                  <field>
                     <name>CONSEC</name>
                     <description>Number of consecutive times the LFCLK period error has to be 
smaller than MAXERR to be considered &#34;good&#34;.
Setting this value to 0 will bypass clock qualification,
and the &#34;good&#34; indicator will always be 1.</description>
                     <bitRange>[7:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFINCCTL</name>
               <description>Low frequency time increment control</description>
               <addressOffset>152</addressOffset>
               <access>read-write</access>
               <resetValue>0x9e848015</resetValue>
               <fields>
                  <field>
                     <name>PREVENTSTBY</name>
                     <description>Controls if the LFINC filter prevents STANBY entry until settled.
</description>
                     <bitRange>[31:31]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <value>0x1</value>
                           <description>Enable. Prevent STANDBY entry.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <value>0x0</value>
                           <description>Disable. Do not prevent STANDBY entry.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KEEPHFXTEN</name>
                     <description>Keeps the HFXT enabled till the LFINC filter settles</description>
                     <bitRange>[30:30]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable. Keep HFXT enabled.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable. Do not keep HFXT enabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INT</name>
                     <description>Integral part of the LFINC filter.

This value is updated by Hardware to reflect the current state of the filter.
It can also be written to change the current state.</description>
                     <bitRange>[29:8]</bitRange>
                  </field>
                  <field>
                     <name>STOPGEAR</name>
                     <description>Controls the final gear of the LFINC filter.</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x1</value>
                           <description>The LF filter is considered settled when LFCLKSTAT2.MAINGEAR reads 8 and  LFCLKSTAT2.SUBGEAR reads 7. That means the LF filter will take 71 LF periods to settle provided the gear does not restarts.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x0</value>
                           <description>The LF filter is considered settled when LFCLKSTAT2.MAINGEAR reads 9 and  LFCLKSTAT2.SUBGEAR reads 7. That means the LF filter will take 79 LF periods to settle provided the gear does not restarts.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERRTHR</name>
                     <description>Controls the threshold for gearing restart of the LFINC filter.

Only effective if GEARRSTRT is not ONETHR or TWOTHR.</description>
                     <bitRange>[6:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SMALL</name>
                           <value>0x3</value>
                           <description>Restart gearing on small error. Potentially more false restarts, faster response on small frequency shifts.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MIDSMALL</name>
                           <value>0x2</value>
                           <description>Middle value towards SMALL.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MIDLARGE</name>
                           <value>0x1</value>
                           <description>Middle value towards LARGE.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LARGE</name>
                           <value>0x0</value>
                           <description>Restart gearing on large error. Fewer false restarts, slower response on small frequency shifts.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>GEARRSTRT</name>
                     <description>Controls gearing restart of the LFINC filter.</description>
                     <bitRange>[4:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TWOTHR</name>
                           <value>0x2</value>
                           <description>Restart gearing when the error accumulator crosses the threshold twice in a row.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ONETHR</name>
                           <value>0x1</value>
                           <description>Restart gearing when the error accumulator crosses the threshold once.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NEVER</name>
                           <value>0x0</value>
                           <description>Never restart gearing. Very stable filter value, but very slow response on frequency changes.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SOFTRSTRT</name>
                     <description>Use a higher gear after re-enabling / wakeup.

The filter will require 16-24 LFCLK periods to settle (depending on STOPGEAR), but may respond faster to frequency changes during STANDBY.</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <value>0x1</value>
                           <description>Use soft gearing restarts</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <value>0x0</value>
                           <description>Don&#39;t use soft gearing restarts</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>Enable LFINC filter. Programming with a value of 0x3 will disable the LFINC filter</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>AUTO</name>
                           <value>0x2</value>
                           <description>Enable based on HFOS getting settled. HFOSC gets settled after the tracking loop has updated equal to or more than LOOPCFG.SETTLED_TARGET times.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>ENABLED</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>DISABLED</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFINCOVR</name>
               <description>Low frequency time increment override control</description>
               <addressOffset>156</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>OVERRIDE</name>
                     <description>Override LF increment

Use the value provided in LFINC instead of the value calculated by Hardware.</description>
                     <bitRange>[31:31]</bitRange>
                  </field>
                  <field>
                     <name>LFINC</name>
                     <description>LF increment value

This value is used when OVERRIDE is set to 1.
Otherwise the value is calculated automatically.
The current LFINC value can be read from [CKM.LFCLKSTAT.LFINC].</description>
                     <bitRange>[21:0]</bitRange>
                  </field>
               </fields>
            </register>
