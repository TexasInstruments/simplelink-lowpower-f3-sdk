                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>APP_AUTH_CLR</name>
               <description>This register is used for clearing bits in APP_AUTH register. 
This register is configured and locked during device boot.</description>
               <addressOffset>536</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>KEY</name>
                     <description>This field must be configured with 0x7D in order to access this register.</description>
                     <bitRange>[31:24]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>_to_unlock_w_</name>
                           <value>0x7d</value>
                           <description>Write this value 0x7D to unlock writing to the APP_AUTH_CLR register</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NIDEN</name>
                     <description>Clears NIDEN bit in APP_AUTH register.
</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clears NIDEN</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGEN</name>
                     <description>Clears DBGEN bit in APP_AUTH register.
</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clears DBGEN</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DBGCTL</name>
               <description>Debug control register. This register is used for controlling debug connection and read out debug status.</description>
               <addressOffset>540</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000020</resetValue>
               <fields>
                  <field>
                     <name>SWDCEN</name>
                     <description>This bit is used to enable connection between SWD pads and IceMelter (wakeup circuit used for detecting debug probe)</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Connection enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Connection disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBGPWRUPACK</name>
                     <description>This bit field specifies the status of dbgpwrupack from pmctl.
</description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>dbgpwrupreq is acknowledged.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>dbgpwrupreq is not acknowledged</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SYSPWRUPACK</name>
                     <description>This bit field specify the status of syspwrupack from pmctl.  

</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>syspwrupreq is acknowledged</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>syspwrupreq is not acknowledged</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>JTAGSEL</name>
                     <description>This bit field specifies the status of JTAG MODE for TEST TAP.
</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>TEST TAP enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>TEST TAP disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SWDSEL</name>
                     <description>This bit field specifies the status of  SWD MODE  for connection.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>debug connection enabled.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>debug connection disabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SWDOVR</name>
                     <description>This bit is used for connecting to IO pads to SWCLK/IO on SW-DP through a software request and establish SWD connection without IceMelter trigger for debug purpose.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DBGENA</name>
                           <value>0x1</value>
                           <description>Force 1 or debug enable mode in which SWD connection is established bypassing IceMelter sequence</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TRNSPRT</name>
                           <value>0x0</value>
                           <description>Transparent mode in which SWD connection is established via IceMelter Sequence.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
