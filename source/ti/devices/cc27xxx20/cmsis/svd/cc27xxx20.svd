            </register>
            <register>
               <name>MCLKDIV</name>
               <description>This field configures MCLK division ratio</description>
               <addressOffset>128</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>MDIV</name>
                     <description>    An unsigned factor of the division ratio used to generate MCLK [2-1024]:
                                            MCLK = MCUCLK/MDIV[Hz] MCUCLK is upto 96MHz. 
                                            A value of 0 is interpreted as 1024.
                                            A value of 1 is invalid. 
                                            If MDIV is odd the low phase of the clock is one MCUCLK period longer than the high phase.</description>
                     <bitRange>[9:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>BCLKDIV</name>
               <description>This field configures BCLK division ratio</description>
               <addressOffset>132</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>BDIV</name>
                     <description>    An unsigned factor of the division ratio used to generate BCLK [2-1024]:
                                            BCLK = MCUCLK/BDIV[Hz] MCUCLK can be upto 96MHz. 
                                            A value of 0 is interpreted as 1024.
                                            A value of 1 is invalid. 
                                            If BDIV is odd and FMTCFG.SMPLEDGE = 0, the low phase of the clock is one MCUCLK period longer than the high phase. 
                                            If BDIV is odd and FMTCFG.SMPLEDGE = 1 , the high phase of the clock is one MCUCLK period longer than the low phase.</description>
                     <bitRange>[9:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>WCLKDIV</name>
               <description>This field configures WCLK division ratio</description>
               <addressOffset>136</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>WDIV</name>
                     <description>   If CLKCTL.WCLKPHASE = 0, Single phase. WCLK is high one BCLK period and low WDIV[9:0] (unsigned, [1-1023]) BCLK periods. 
                                           WCLK = MCUCLK / BDIV*(WDIV[9:0] + 1) [Hz] MCUCLK upto 96MHz. 
                                           If [CLKCTL.WCLKPHASE.*] = 1, Dual phase. Each phase on WCLK (50% duty cycle) is WDIV[9:0] (unsigned, [1-1023]) BCLK periods. 
                                           **WCLK **= **MCUCLK **/ BDIV*(2*WDIV[9:0]) [Hz] 
                                           If [CLKCTL.WCLKPHASE.*] = 2, User defined. WCLK is high WDIV[7:0] (unsigned, [1-255]) BCLK periods and low WDIV[15:8] (unsigned, [1-255]) BCLK periods.
                                           WCLK = **MCUCLK **/ (BDIV*(WDIV[7:0] + WDIV[15:8]) [Hz]</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKCTL</name>
               <description>This register controls internal audio clock</description>
               <addressOffset>140</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>MEN</name>
                     <description>This field configures the MCLK generation</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the generation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable the generation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WCLKPHASE</name>
                     <description>The field configures how the WCLK division ratio is calculated and used to generate different duty cycles (See WCLKDIV.WDIV)</description>
                     <bitRange>[2:1]</bitRange>
                  </field>
                  <field>
                     <name>WBEN</name>
                     <description>This field configures WCLK/BCLK generation </description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable the generation</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disables the generation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DTB</name>
               <description>Digital test bus control</description>
               <addressOffset>144</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SEL</name>
                     <description>The field controls the select of DTB </description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SEL_3</name>
                           <value>0x3</value>
                           <description>{12{1&#39;b0},aif_words_sampled, aif_word_loaded, aif_output_en, aif_input_en}</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEL_2</name>
                           <value>0x2</value>
                           <description>Samplestamp XCNT(16 bits)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEL_1</name>
                           <value>0x1</value>
                           <description>Samplestamp WCNT(16 bits)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEL_0</name>
                           <value>0x0</value>
                           <description>None is selected</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
