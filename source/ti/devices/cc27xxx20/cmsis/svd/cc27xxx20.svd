                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_SRAM_REP_DONE</name>
                           <value>0x2</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT_COLD_BOOT</name>
                           <value>0x1</value>
