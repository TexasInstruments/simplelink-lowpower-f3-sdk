                     <bitRange>[12:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Clock is requested</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Clock not requested</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
