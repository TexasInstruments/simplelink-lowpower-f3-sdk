            <register>
               <name>MCANSS_CLKDIV</name>
               <description>Clock Divider. Configuring Clock divider setting for MCAN functional clock.</description>
               <addressOffset>2308</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RATIO</name>
                     <description>Clock divide ratio specification. Enables configuring clock divide settings for the MCAN functional clock input to the MCAN-SS. </description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIV_BY_4_</name>
                           <value>0x2</value>
                           <description>Divides input clock by 4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_2_</name>
                           <value>0x1</value>
                           <description>Divides input clock by 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_1_</name>
                           <value>0x0</value>
                           <description>Divides input clock by 1</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MCANSS_CLKCTL</name>
               <description>MCANSS clock stop control MMR. </description>
               <addressOffset>2312</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>WKUP_GLTFLT_EN</name>
                     <description>Setting this bit enables the glitch filter on MCAN RXD input, which wakes up the MCAN controller to exit clock gating. </description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable glitch filter enable on RXD input when MCAN is in clock stop mode (waiting for event on RXD input for clock stop wakeup). </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable glitch filter enable on RXD input when MCAN is in clock stop mode (waiting for event on RXD input for clock stop wakeup). </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WAKEUP_INT_EN</name>
                     <description>This bit contols enabling or disabling the MCAN IP clock stop wakeup interrupt (when MCANSS_CTRL.WAKEUPREQEN wakeup request is enabled to wakeup MCAN IP upon CAN RXD activity)</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable MCAN IP clock stop wakeup interrupt </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable MCAN IP clock stop wakeup interrupt </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STOPREQ</name>
                     <description>This bit is used to enable/disable MCAN clock (both host clock and functional clock) gating request.

Note: This bit can be reset by HW by Clock-Stop Wake-up via CAN RX Activity. 
</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ENABLE</name>
                           <value>0x1</value>
                           <description>Enable MCAN-SS clock stop request</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Disable MCAN-SS clock stop request</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MCANSS_CLKSTS</name>
               <description>MCANSS clock stop status register to indicate status of clock stop mechanism</description>
               <addressOffset>2316</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STOPREQ_HW_OVR</name>
                     <description>MCANSS clock stop HW override status bit. 

This bit indicates when the MCANSS_CLKCTL.STOPREQ bit has been cleared by HW when a clock-stop wake-up event via CAN RX activity is trigged. </description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>MCANSS_CLKCTL.STOPREQ bit has been cleared by HW. </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RESET</name>
                           <value>0x0</value>
