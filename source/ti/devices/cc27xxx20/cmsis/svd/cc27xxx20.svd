               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>RES</name>
                     <description>This bit decides the RESOLUTION of the channel that will be used.</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NS</name>
                           <value>0x1</value>
                           <description>channel Works in Timer&#39;s 250ns resolution</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>US</name>
                           <value>0x0</value>
                           <description>channel Works in Timer&#39;s 1us Resolution.</description>
