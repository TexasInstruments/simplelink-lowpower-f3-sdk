               <fields>
                  <field>
                     <name>MB2PACC</name>
                     <description>0: Output mailbox 2 can be accessed by the Host using protected or non-protected access. 1: Output mailbox 2 is only accessible if the Host uses protected access.</description>
                     <bitRange>[7:7]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MB2ID</name>
                     <description>Host cpu_id of the Host allowed to read a result from the Mailbox 2</description>
                     <bitRange>[6:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MB1PACC</name>
                     <description>0: Output mailbox 1 can be accessed by the Host using protected or non-protected access. 1: Output mailbox 1 is only accessible if the Host uses protected access.</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MB1ID</name>
                     <description>HostID of the Host allowed to read a result from the Mailbox 1</description>
                     <bitRange>[2:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
