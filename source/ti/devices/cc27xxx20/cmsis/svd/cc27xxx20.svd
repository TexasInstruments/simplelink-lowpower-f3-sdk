                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXIFG</name>
                     <description>Sets RXIFG in RIS register</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set interrupt</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
