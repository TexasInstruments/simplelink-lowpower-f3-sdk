                     <name>SRC</name>
                     <description></description>
                     <bitRange>[3:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>C11CC</name>
                           <value>0xf</value>
                           <description>Setting of RIS.C11CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C10CC</name>
                           <value>0xe</value>
                           <description>Setting of RIS.C10CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C9CC</name>
                           <value>0xd</value>
                           <description>Setting of RIS.C9CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C8CC</name>
                           <value>0xc</value>
                           <description>Setting of RIS.C8CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C7CC</name>
                           <value>0xb</value>
                           <description>Setting of RIS.C7CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C6CC</name>
                           <value>0xa</value>
                           <description>Setting of RIS.C6CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C5CC</name>
                           <value>0x9</value>
                           <description>Setting of RIS.C5CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C4CC</name>
                           <value>0x8</value>
                           <description>Setting of RIS.C4CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C3CC</name>
                           <value>0x7</value>
                           <description>Setting of RIS.C3CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C2CC</name>
                           <value>0x6</value>
                           <description>Setting of RIS.C2CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C1CC</name>
                           <value>0x5</value>
                           <description>Setting of RIS.C1CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>C0CC</name>
                           <value>0x4</value>
                           <description>Setting of RIS.C0CC generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FAULT</name>
                           <value>0x3</value>
                           <description>Setting of RIS.FAULT generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZERO</name>
                           <value>0x2</value>
                           <description>Setting of RIS.ZERO generates an ADC trigger.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TGT</name>
                           <value>0x1</value>
                           <description>Setting of RIS.TGT generates an ADC trigger.
</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IOCTL</name>
               <description>IO Controller

This register overrides the IO outputs.</description>
               <addressOffset>72</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>COUT2</name>
                     <description>IO complementary output 2 control

This bit field controls IO complementary output 2. </description>
                     <bitRange>[11:10]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INV</name>
                           <value>0x3</value>
                           <description>Inverted value. The IO complementary output is inverted.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x2</value>
                           <description>Driven high. The IO complementary output is driven high.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x1</value>
                           <description>Driven low. The IO complementary output is driven low.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NRM</name>
                           <value>0x0</value>
                           <description>Normal output. The IO complementary output is not changed.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OUT2</name>
                     <description>IO output 2 control

This bit field controls IO output 2. </description>
                     <bitRange>[9:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INV</name>
                           <value>0x3</value>
                           <description>Inverted value. The IO output is inverted.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x2</value>
                           <description>Driven high. The IO output is driven high.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x1</value>
                           <description>Driven low. The IO output is driven low.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NRM</name>
                           <value>0x0</value>
                           <description>Normal output. The IO output is not changed.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>COUT1</name>
                     <description>IO complementary output 1 control

This bit field controls IO complementary output 1. </description>
                     <bitRange>[7:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INV</name>
                           <value>0x3</value>
                           <description>Inverted value. The IO complementary output is inverted.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x2</value>
                           <description>Driven high. The IO complementary output is driven high.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x1</value>
                           <description>Driven low. The IO complementary output is driven low.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NRM</name>
                           <value>0x0</value>
                           <description>Normal output. The IO complementary output is not changed.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OUT1</name>
                     <description>IO output 1 control

This bit field controls IO output 1. </description>
                     <bitRange>[5:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INV</name>
                           <value>0x3</value>
                           <description>Inverted value. The IO output is inverted.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x2</value>
                           <description>Driven high. The IO output is driven high.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x1</value>
                           <description>Driven low. The IO output is driven low.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NRM</name>
                           <value>0x0</value>
                           <description>Normal output. The IO output is not changed.</description>
