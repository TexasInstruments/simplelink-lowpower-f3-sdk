                     <bitRange>[30:30]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ROMID</name>
                           <value>0x1</value>
                           <description>Assert</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>APPID</name>
                           <value>0x0</value>
                           <description>Dassert</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REFMARK</name>
                     <description>Refresher Marker. Trigger writting refresh marker. This bit is auto cleared when programming is done</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TRG</name>
                           <value>0x1</value>
                           <description>Trigger/Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DONE</name>
                           <value>0x0</value>
                           <description>Done</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAFWDIS</name>
                     <description>DMA Firewall Disable</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x1</value>
                           <description>DMA Firewall Disabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x0</value>
                           <description>DMA Firewall Enabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OTPBUSY</name>
                     <description>OTP Busy. OTP contoller is busy</description>
                     <bitRange>[5:5]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>OTPEVTST</name>
