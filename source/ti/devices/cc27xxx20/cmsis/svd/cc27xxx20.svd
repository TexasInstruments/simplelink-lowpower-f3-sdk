      <peripheral>
         <name>PMCTL</name>
         <description>This component is the Power Management controller. Together with the System Controller, it controls system resets and the power states of the device. 
 
</description>
         <baseAddress>0x40000000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>DESC</name>
               <description>Description Register.
This register provides IP module ID, revision information, instance index and standard MMR registers offset.</description>
               <addressOffset>0</addressOffset>
               <access>read-only</access>
               <resetValue>0xd7410020</resetValue>
               <fields>
                  <field>
                     <name>MODID</name>
                     <description>Module identifier used to uniquely identify this IP.</description>
                     <bitRange>[31:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STDIPOFF</name>
                     <description>Standard IP MMR block offset. Standard IP MMRs are the set of from aggregated IRQ registers till DTB.

0: Standard IP MMRs do not exist
0x1-0xF: Standard IP MMRs begin at offset of (64*STDIPOFF from the base IP address)</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INSTIDX</name>
                     <description>IP Instance ID number. If multiple instances of IP exist in the device, this field can identify the instance number (0-15).</description>
                     <bitRange>[11:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MAJREV</name>
                     <description>Major revision of IP (0-15).</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor revision of IP (0-15).</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>DESCEX</name>
               <description>Extended Description Register.
This register shows ULL IP availability and memory size configuration.</description>
               <addressOffset>4</addressOffset>
               <access>read-only</access>
               <resetValue>0xf4000000</resetValue>
               <fields>
                  <field>
                     <name>FLASHSZ</name>
                     <description>System flash availability</description>
                     <bitRange>[31:30]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SZ3</name>
                           <value>0x3</value>
                           <description>Flash size set to level 3 (Max size)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ2</name>
                           <value>0x2</value>
                           <description>Flash size set to level 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ1</name>
                           <value>0x1</value>
                           <description>Flash size set to level 1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ0</name>
                           <value>0x0</value>
                           <description>Flash size set to level 0 (Min size)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SRAMSZ</name>
                     <description>System SRAM availability</description>
                     <bitRange>[29:28]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SZ3</name>
                           <value>0x3</value>
                           <description>SRAM size set to level 3 (Max size)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ2</name>
                           <value>0x2</value>
                           <description>SRAM size set to level 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ1</name>
                           <value>0x1</value>
                           <description>SRAM size set to level 1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SZ0</name>
                           <value>0x0</value>
                           <description>SRAM size set to level 0 (Min size)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LPCMP</name>
                     <description>LPCMP (low power comparator) IP status on device</description>
                     <bitRange>[26:26]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IP_AVAIL</name>
                           <value>0x1</value>
                           <description>IP is available</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IP_UNAVAIL</name>
                           <value>0x0</value>
                           <description>IP is unavailable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SHTDWN</name>
               <description>Shutdown Register.
This register controls SHUTDOWN mode entry.</description>
               <addressOffset>8</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>KEY</name>
                     <description>Setting a valid key will trigger the device to enter SHUTDOWN mode.</description>
                     <bitRange>[15:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VALID</name>
                           <value>0xa5a5</value>
                           <description>This is the only valid key value that will trigger SHUTDOWN mode.
All other values are invalid and will have no effect.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SLPCTL</name>
               <description>Sleep Control Register.
This register controls I/O pad sleep mode. When I/O pad sleep mode is enabled all I/O pad outputs and I/O pad configurations are latched. Inputs are transparent if I/O pad is configured as input.</description>
               <addressOffset>12</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SLPN</name>
                     <description>The boot code will set this bit field and disable sleep mode, automatically unless waking up from a SHUTDOWN RSTSTA.SDDET is set.
Application software must reconfigure the state for all IO&#39;s before setting this bit field upon waking up from a SHUTDOWN to avoid glitches on pins.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x1</value>
                           <description>I/O pad sleep mode is disabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x0</value>
                           <description>I/O pad sleep mode is enabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>WUSTA</name>
               <description>Wakeup Status Register
This register shows the device wakeup source. Used to distinguish between wakeup from STANDBY, SHUTDOWN and reset.</description>
               <addressOffset>16</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>SRC</name>
                     <description>This field shows the device wakeup source.</description>
                     <bitRange>[1:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STBY</name>
                           <value>0x2</value>
                           <description>Wakeup from STANDBY mode.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RST_SHTDWN</name>
                           <value>0x1</value>
                           <description>Wakeup from system reset / SHUTDOWN mode. 
See RSTSTA for more status information.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>VDDRCTL</name>
               <description>VDDR Control Register.
This register contains VDDR regulator settings for the device.</description>
               <addressOffset>20</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>STBY</name>
                     <description>Select between continuous or duty-cycled VDDR regulation in STANDBY mode.</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PSUEDO</name>
                           <value>0x1</value>
                           <description>Continuous VDDR regulation in STANDBY mode.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NORMAL</name>
                           <value>0x0</value>
                           <description>Duty-cycled VDDR regulation in STANDBY mode.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SELECT</name>
                     <description>Select between GLDO and DCDC as VDDR regulator (in ACTIVE, IDLE and STANDBY mode).</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DCDC</name>
                           <value>0x1</value>
                           <description>DCDC enabled for regulation of VDDR voltage</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GLDO</name>
                           <value>0x0</value>
                           <description>GLDO enabled for regulation of VDDR voltage</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYSFSET</name>
               <description>Internal. Only to be used through TI provided API.</description>
               <addressOffset>32</addressOffset>
               <access>write-only</access>
