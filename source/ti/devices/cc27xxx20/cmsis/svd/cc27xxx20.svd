                     <description>Clear interrupt status for MEMRES1.</description>
                     <bitRange>[9:9]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>A new data is ready to be read.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_EFFECT</name>
                           <value>0x0</value>
                           <description>No new data ready.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MEMRESIFG0</name>
                     <description>Clear interrupt status for MEMRES0.</description>
                     <bitRange>[8:8]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>A new data is ready to be read.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_EFFECT</name>
                           <value>0x0</value>
                           <description>No new data ready.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL0</name>
               <description>Control Register 0 </description>
               <addressOffset>256</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SCLKDIV</name>
                     <description>Sample clock divider</description>
                     <bitRange>[26:24]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIV_BY_48</name>
                           <value>0x7</value>
                           <description>Divide clock source by 48</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_32</name>
                           <value>0x6</value>
                           <description>Divide clock source by 32</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_24</name>
                           <value>0x5</value>
                           <description>Divide clock source by 24</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_16</name>
                           <value>0x4</value>
                           <description>Divide clock source by 16</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_8</name>
                           <value>0x3</value>
                           <description>Divide clock source by 8</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_4</name>
                           <value>0x2</value>
                           <description>Divide clock source by 4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_2</name>
                           <value>0x1</value>
                           <description>Divide clock source by 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_1</name>
                           <value>0x0</value>
                           <description>Do not divide clock source</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PWRDN</name>
                     <description>Power down policy</description>
                     <bitRange>[16:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MANUAL</name>
                           <value>0x1</value>
                           <description>ADC remains powered on as long as it is enabled through software.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUTO</name>
                           <value>0x0</value>
                           <description>ADC is powered down on completion of a conversion if there is no pending trigger</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENC</name>
                     <description>Enable conversion</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ON</name>
                           <value>0x1</value>
                           <description>Conversion enabled. ADC sequencer waits for the programmed trigger (software or hardware).</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <value>0x0</value>
                           <description>Conversion disabled. ENC change from ON to OFF will abort single or repeat sequence on a MEMCTLx boundary. The current conversion will finish and result stored in corresponding MEMRESx.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL1</name>
               <description>Control Register 1</description>
               <addressOffset>260</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SAMPMODE</name>
                     <description>Sample mode. This bit selects the source of the sampling signal. 
MANUAL option is not applicable when TRIGSRC is selected as hardware event trigger.</description>
                     <bitRange>[20:20]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MANUAL</name>
                           <value>0x1</value>
                           <description>Software trigger is used as sample signal</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUTO</name>
                           <value>0x0</value>
                           <description>Sample timer high phase is used as sample signal</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CONSEQ</name>
                     <description>Conversion sequence mode</description>
                     <bitRange>[17:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>REPEATSEQUENCE</name>
                           <value>0x3</value>
                           <description>ADC channel sequence pointed by STARTADD and ENDADD will be converted repeatedly</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REPEATSINGLE</name>
                           <value>0x2</value>
                           <description>ADC channel in MEMCTLx pointed by STARTADD will be converted repeatedly</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEQUENCE</name>
                           <value>0x1</value>
                           <description>ADC channel sequence pointed by STARTADD and ENDADD will be converted once</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <value>0x0</value>
                           <description>ADC channel in MEMCTLx pointed by STARTADD will be converted once</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SC</name>
                     <description>Start of conversion</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>START</name>
                           <value>0x1</value>
                           <description>When SAMPMODE is set to MANUAL, setting this bit will start the sample phase. Sample phase will last as long as this bit is set. 
When SAMPMODE is set to AUTO, setting this bit will trigger the timer based sample time.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STOP</name>
                           <value>0x0</value>
                           <description>When SAMPMODE is set to MANUAL, clearing this bit will end the sample phase and the conversion phase will start.
When SAMPMODE is set to AUTO, writing 0 has no effect.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TRIGSRC</name>
                     <description>Sample trigger source</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EVENT</name>
                           <value>0x1</value>
                           <description>Hardware event trigger</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SOFTWARE</name>
                           <value>0x0</value>
                           <description>Software trigger</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL2</name>
               <description>Control Register 2</description>
               <addressOffset>264</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ENDADD</name>
                     <description>Sequence end address. These bits select which MEMCTLx is the last one for the sequence mode.
The value of ENDADD is 0x00 to 0x03 corresponding to MEMRES0 to MEMRES3.</description>
                     <bitRange>[28:24]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ADDR_03</name>
                           <value>0x3</value>
                           <description>MEMCTL3 is selected as end address of sequence.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_02</name>
                           <value>0x2</value>
                           <description>MEMCTL2 is selected as end address of sequence.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_01</name>
                           <value>0x1</value>
                           <description>MEMCTL1 is selected as end address of sequence.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_00</name>
                           <value>0x0</value>
                           <description>MEMCTL0 is selected as end address of sequence.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STARTADD</name>
                     <description>Sequencer start address. These bits select which MEMCTLx is used for single conversion or as first MEMCTL for sequence mode. 
The value of STARTADD is 0x00 to 0x17, corresponding to MEMRES0 to MEMRES23.</description>
                     <bitRange>[20:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ADDR_03</name>
                           <value>0x3</value>
                           <description>MEMCTL3 is selected as start address of a sequence or for a single conversion.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_02</name>
                           <value>0x2</value>
                           <description>MEMCTL2 is selected as start address of a sequence or for a single conversion.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_01</name>
                           <value>0x1</value>
                           <description>MEMCTL1 is selected as start address of a sequence or for a single conversion.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDR_00</name>
                           <value>0x0</value>
                           <description>MEMCTL0 is selected as start address of a sequence or for a single conversion.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FIFOEN</name>
                     <description>Enable FIFO based operation</description>
                     <bitRange>[10:10]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMAEN</name>
                     <description>Enable DMA trigger for data transfer. 
Note: DMAEN bit is cleared by hardware based on DMA done signal at the end of data transfer. Software has to re-enable DMAEN bit for ADC to generate DMA triggers.</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>DMA trigger enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>DMA trigger not enabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES</name>
                     <description>Resolution. These bits define the resolutoin of ADC conversion result.
Note : A value of 3 defaults to 12-bits resolution.</description>
                     <bitRange>[2:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BIT_8</name>
                           <value>0x2</value>
                           <description>8-bits resolution</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BIT_10</name>
                           <value>0x1</value>
                           <description>10-bits resolution</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BIT_12</name>
                           <value>0x0</value>
                           <description>12-bits resolution</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DF</name>
                     <description>Data read-back format. Data is always stored in binary unsigned format.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SIGNED</name>
                           <value>0x1</value>
                           <description>Digital result reads Signed Binary. (2s complement), left aligned.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UNSIGNED</name>
                           <value>0x0</value>
                           <description>Digital result reads as Binary Unsigned. </description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL3</name>
               <description>Control Register 3. This register is used to configure ADC for ad-hoc single conversion.</description>
               <addressOffset>268</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ASCVRSEL</name>
                     <description>Selects voltage reference for ASC operation. AREF- must be connected to on-board ground when external reference option is selected.
Note: Writing value 0x3 defaults to INTREF.</description>
                     <bitRange>[13:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
