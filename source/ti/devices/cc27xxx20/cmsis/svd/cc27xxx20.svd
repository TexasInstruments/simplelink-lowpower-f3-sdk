                           <description>Set output mailbox empty</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB2IN</name>
                     <description>The Host linked to input mailbox 2 can set after placing a token into Input Mailbox 2</description>
                     <bitRange>[4:4]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FULL</name>
