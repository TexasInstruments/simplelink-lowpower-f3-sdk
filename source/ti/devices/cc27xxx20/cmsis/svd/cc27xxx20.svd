                           <description>Unlink Mailbox 1</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB1LNK</name>
                     <description>Link Mailbox to this Host. Host can link to a mailbox only if it is not filled and not linked to another host</description>
                     <bitRange>[2:2]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LNK</name>
                           <value>0x1</value>
                           <description>Link Mailbox 1</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB1OUT</name>
                     <description>The Host for whom the token is in Output Mailbox 1 can clear the status</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EMTY</name>
                           <value>0x1</value>
                           <description>Set output mailbox empty</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB1IN</name>
                     <description>The Host linked to input mailbox 1 can set after placing a token into Input Mailbox 1</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FULL</name>
                           <value>0x1</value>
                           <description>Set Input Mailbox full</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
