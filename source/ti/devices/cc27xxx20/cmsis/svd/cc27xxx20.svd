                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FULL</name>
                           <value>0x1</value>
                           <description>Mailbox is Full</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EMTY</name>
                           <value>0x0</value>
                           <description>Mailbox is Empty</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MB1AVAIL</name>
                     <description>Input Mailbox 1 available status</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
