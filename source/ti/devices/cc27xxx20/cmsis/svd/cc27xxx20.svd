      <peripheral>
         <name>EVTULL</name>
         <description>This is top module of Event Fabric  for LOKI</description>
         <baseAddress>0x40005000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>DESC</name>
               <description>Description Register.This register provides IP module ID, revision information, instance index and standard MMR registers offset.</description>
               <addressOffset>0</addressOffset>
               <access>read-only</access>
               <resetValue>0x30451010</resetValue>
               <fields>
                  <field>
                     <name>MODID</name>
                     <description>Module identifier used to uniquely identify this IP.</description>
                     <bitRange>[31:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STDIPOFF</name>
                     <description>Standard IP MMR block offset. Standard IP MMRs are the set of from aggregated IRQ registers till DTB.
0: Standard IP MMRs do not exist
0x1-0xF: Standard IP MMRs begin at offset of (64*STDIPOFF from the base IP address)</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INSTIDX</name>
                     <description>IP Instance ID number. If multiple instances of IP exist in the device, this field can identify the instance number (0-15).</description>
                     <bitRange>[11:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MAJREV</name>
                     <description>Major revision of IP (0-15).</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor revision of IP (0-15).</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>DESCEX</name>
               <description>Extended Description Register. This register provides configuration details of the IP to software drivers and end users.
</description>
               <addressOffset>4</addressOffset>
               <access>read-only</access>
               <resetValue>0x00010106</resetValue>
               <fields>
                  <field>
                     <name>IDMA</name>
                     <description>Number of DMA input  channels</description>
                     <bitRange>[31:22]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>NDMA</name>
                     <description>Number of DMA output channels</description>
                     <bitRange>[21:17]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>PD</name>
                     <description>Power Domain.
0 : SVT
 1 : ULL</description>
                     <bitRange>[16:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>NSUB</name>
                     <description>Number of Subscribers</description>
                     <bitRange>[15:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>NPUB</name>
                     <description>Number of Publishers</description>
                     <bitRange>[7:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>DTB</name>
               <description>Digital test bus control register. This register can be used to bring out IP internal signals to the pads for observation. 16 signals can be observed per select value.</description>
               <addressOffset>100</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SEL</name>
                     <description>Digital test bus selection mux control.
Non-zero select values output a 16 bit selected group of signals per value.</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>RTCCPTSEL</name>
               <description>Output Selection for RTCCPT Register.
</description>
               <addressOffset>1028</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PUBID</name>
                     <description>Read/write selection value.
Writing any other value than values defined by a ENUM may result in undefined behavior.</description>
                     <bitRange>[6:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
