                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEMPTY</name>
                     <description>Clear Transmit FIFO Empty event mask</description>
                     <bitRange>[5:5]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TX</name>
                     <description>Clear Transmit FIFO event mask</description>
                     <bitRange>[4:4]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RX</name>
                     <description>Clear Receive FIFO event mask</description>
                     <bitRange>[3:3]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTOUT</name>
                     <description>Clear SPI Receive Time-Out event mask</description>
                     <bitRange>[2:2]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PER</name>
                     <description>Clear Parity error event mask</description>
                     <bitRange>[1:1]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXOVF</name>
                     <description>Clear RXFIFO overflow event mask</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear interrupt mask</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Writing 0 has no effect</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>EMU</name>
               <description>Emulation control register. This register controls the behavior of the IP related to core halted input.</description>
               <addressOffset>96</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>HALT</name>
                     <description>Halt control</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>STOP</name>
                           <value>0x1</value>
                           <description> Freeze option. The IP freezes functionality when the core halted input is asserted, and resumes when it is deasserted. The freeze can either be immediate or after the IP has reached a boundary (end of word boundary, based on DSS configuration) from where it can resume without corruption.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUN</name>
                           <value>0x0</value>
                           <description>Free run option. The IP ignores the state of the core halted input.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL0</name>
               <description>SPI control register 0</description>
               <addressOffset>256</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>IDLEPOCI</name>
                     <description>The Idle value of POCI - when TXFIFO is empty and before data is written into TXFIFO - can be controlled by this field.</description>
                     <bitRange>[17:17]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IDLE_ONE</name>
                           <value>0x1</value>
                           <description>POCI outputs idle value of &#39;1&#39;</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE_ZERO</name>
                           <value>0x0</value>
                           <description>POCI output idle value of &#39;0&#39;</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>GPCRCEN</name>
                     <description>General purpose CRC enable. This bit enables transmit side CRC unit for general purpose use by software when SPI is disabled (CTL1.EN = 0). This bit must be 0 when SPI is enabled.</description>
                     <bitRange>[16:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Transmit side CRC unit is available for general purpose software use</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Transmit side CRC unit is not available for general purpose software use</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CRCPOLY</name>
                     <description>CRC polynomial selection.</description>
                     <bitRange>[15:15]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SIZE16BIT</name>
                           <value>0x1</value>
                           <description>Selects 16-bit CCITT CRC polynomial</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SIZE8BIT</name>
                           <value>0x0</value>
                           <description>Selects 8-bit CCITT CRC polynomial</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AUTOCRC</name>
                     <description>Auto insert CRC</description>
                     <bitRange>[14:14]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Insert CRC into TXFIFO upon TXFIFO underflow</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Do not insert CRC into TXFIFO upon TXFIFO underflow
</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CRCEND</name>
                     <description>CRC16 Endianness</description>
                     <bitRange>[13:13]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CRC_END_LSB</name>
                           <value>0x1</value>
                           <description>Auto-insertion of CRC16 is least-significant byte first</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CRC_END_MSB</name>
                           <value>0x0</value>
                           <description>Auto-insertion of CRC16 is most-significant byte first

</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSCLR</name>
                     <description>Clear shift register counter on CS inactive.
This bit is relevant only in the peripheral mode, when CTL1.MS=0.
</description>
                     <bitRange>[12:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable automatic clear of shift register when CS goes inactive.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable automatic clear of shift register when CS goes inactive.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FIFORST</name>
                     <description>This bit is used to reset transmit and receive FIFO pointers. This bit is auto cleared once the FIFO pointer reset operation is completed.</description>
                     <bitRange>[11:11]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RST_TRIG</name>
                           <value>0x1</value>
                           <description>Trigger FIFO pointers reset when written to 1.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RST_DONE</name>
                           <value>0x0</value>
                           <description>FIFO pointers reset completed when 0 is read</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HWCSN</name>
                     <description>Hardware controlled chip select (CS) value. When set CS is zero till TX FIFO is empty, as in - 
a.	CS is de-asserted
b.	All data bytes are transmitted
c.	CS is asserted
</description>
                     <bitRange>[10:10]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>HWCSN Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>HWCSN Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SPH</name>
                     <description>SCLK phase (Motorola SPI frame format only).
This bit selects the clock edge that captures data and enables it to change state. 
It has the most impact on the first bit transmitted by either permitting or not permitting a clock transition before the first data capture clock edge.</description>
                     <bitRange>[9:9]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SECOND</name>
                           <value>0x1</value>
                           <description>Data is captured on the second clock edge transition.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FIRST</name>
                           <value>0x0</value>
                           <description>Data is captured on the first clock edge transition.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SPO</name>
                     <description>SCLK polarity (Motorola SPI frame format only).</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HI</name>
                           <value>0x1</value>
                           <description>SPI produces a steady state HI value on the SCLK</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LO</name>
                           <value>0x0</value>
                           <description>SPI produces a steady state LO value on the SCLK</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FRF</name>
                     <description>Frame format select</description>
                     <bitRange>[6:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MICROWIRE</name>
                           <value>0x3</value>
                           <description>MICROWIRE frame format</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TI_SYNC</name>
                           <value>0x2</value>
                           <description>TI synchronous serial frame format</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOTOROLA_4WIRE</name>
                           <value>0x1</value>
                           <description>Motorola SPI frame format (4-wire mode)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOTOROLA_3WIRE</name>
                           <value>0x0</value>
                           <description>Motorola SPI frame format (3-wire mode)</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DSS</name>
                     <description>Data size select. The applicable DSS values for controller mode operation are 0x3 to 0xF and for peripheral mode operation are 0x6 to 0xF. DSS values 0x0 to 0x2 are reserved and must not be used.</description>
                     <bitRange>[3:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BITS_16</name>
                           <value>0xf</value>
                           <description>16-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_15</name>
                           <value>0xe</value>
                           <description>15-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_14</name>
                           <value>0xd</value>
                           <description>14-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_13</name>
                           <value>0xc</value>
                           <description>13-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_12</name>
                           <value>0xb</value>
                           <description>12-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_11</name>
                           <value>0xa</value>
                           <description>11-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_10</name>
                           <value>0x9</value>
                           <description>10-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_9</name>
                           <value>0x8</value>
                           <description>9-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_8</name>
                           <value>0x7</value>
                           <description>8-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_7</name>
                           <value>0x6</value>
                           <description>7-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_6</name>
                           <value>0x5</value>
                           <description>6-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_5</name>
                           <value>0x4</value>
                           <description>5-bits data size</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BITS_4</name>
                           <value>0x3</value>
                           <description>4-bits data size</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL1</name>
               <description>SPI control register 1</description>
               <addressOffset>260</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000004</resetValue>
               <fields>
                  <field>
                     <name>RTOUT</name>
                     <description>Receive Timeout (only for Peripheral mode)
Defines the number of  CLKSVT clock cycles after which the Receive Timeout flag RIS.RTOUT is set.
A value of 0 disables this function.</description>
                     <bitRange>[29:24]</bitRange>
                  </field>
                  <field>
                     <name>REPTX</name>
                     <description>Counter to repeat last transfer (only in controller mode)
0: repeat last transfer is disabled.
x: repeat the last transfer with the provided value.
The transfer will be started with writing a data into the TX FIFO. Sending the data will be repeated REPTX number of times, so the data will be transferred x+1 times in total.
It can be used to clean a transfer or to pull a certain amount of data by a peripheral.
</description>
                     <bitRange>[23:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>REPTX disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CDMODE</name>
                     <description>Command Data Mode. This bit field value determines the behavior of C/D or CS signal when CDEN = 1. CS pin held low indicates command phase and CS pin held high indicates data phase. 
When CDMODE = 0x0, the CS pin is always held high during transfer indicating data phase only operation (manual mode). 
When CDMODE = 0xF, the CS pin is always held low during transfer indicating command phase only operation (manual mode). 
When CDMODE = 0x1 to 0xE, the CS pin is held low for the number of bytes indicated by CDMODE value for the command phase and held high for the remaining transfers in the data phase (automatic mode).
When CDMODE is set to value 0x1 to 0xE, reading CDMODE during operation indicates the remaining bytes to be transferred in the command phase.

</description>
                     <bitRange>[15:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>COMMAND</name>
                           <value>0xf</value>
                           <description>Manual mode: Command</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DATA</name>
                           <value>0x0</value>
                           <description>Manual mode: Data</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CDEN</name>
                     <description>Command/Data mode enable. This feature is applicable only in controller mode and for 8-bit transfers (CTL0.DSS = 7). The chip select pin is used for command/data signaling in Motorola SPI frame format (3-wire) operation.</description>
                     <bitRange>[11:11]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>C/D Mode Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>C/D Mode Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PBS</name>
                     <description>Parity bit select
</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BIT1</name>
                           <value>0x1</value>
                           <description>Bit 1 is used for Parity, Bit 0 is ignored
</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BIT0</name>
                           <value>0x0</value>
                           <description>Bit 0 is used for Parity
</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PES</name>
                     <description>Even parity select.</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EVEN</name>
                           <value>0x1</value>
                           <description>Even Parity mode</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ODD</name>
                           <value>0x0</value>
                           <description>Odd Parity mode</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PEN</name>
                     <description>Parity enable. If enabled the last bit will be used as parity to evaluate the correct reception of the previous bits. 
In case of parity mismatch the parity error flag RIS.PER will be set. This feature is available only in SPI controller mode. </description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable Parity function </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable Parity function</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MSB</name>
                     <description>MSB first select. Controls the direction of receive and transmit shift register. MSB first configuration (MSB = 1) must be selected when CRC feature is used for SPI communication.</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>MSB</name>
                           <value>0x1</value>
                           <description>MSB first</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LSB</name>
                           <value>0x0</value>
                           <description>LSB first</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>POD</name>
                     <description>Peripheral data output disable. 
This bit is relevant only in the peripheral mode, MS=1. In multiple-peripheral systems, it is possible for a SPI controller to broadcast a message to all peripherals in the system while ensuring that only one peripheral drives data onto its serial output line. In such systems the POCI lines from multiple peripherals could be tied together. To operate in such systems, this bit field can be set if the SPI peripheral is not supposed to drive the POCI output.</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>SPI cannot drive the POCI output in peripheral mode.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>SPI can drive the POCI output in peripheral mode.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MS</name>
                     <description>Controller or peripheral mode select. This bit can be modified only when SPI is disabled, CTL1.EN=0.
</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CONTROLLER</name>
                           <value>0x1</value>
                           <description>Select Controller mode</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PERIPHERAL</name>
                           <value>0x0</value>
                           <description>Select Peripheral mode</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LBM</name>
                     <description>Loop back mode control</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable loopback mode. Output of transmit serial shifter is connected to input of receive serial shifter internally.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable loopback mode. Normal serial port operation enabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>SPI enable.
NOTE: This bit field must be set to 1 using a separate write access, after the other bit fields have been configured.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>SPI Enabled and released for operation.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>SPI is disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKCFG0</name>
               <description>Clock configuration register 0. This register is used to configure the clock prescaler.</description>
               <addressOffset>264</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PRESC</name>
                     <description>Prescaler configuration</description>
                     <bitRange>[2:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIV_BY_8</name>
                           <value>0x7</value>
                           <description>Divide clock source by 8</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_7</name>
                           <value>0x6</value>
                           <description>Divide clock source by 7</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_6</name>
                           <value>0x5</value>
                           <description>Divide clock source by 6</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_5</name>
                           <value>0x4</value>
                           <description>Divide clock source by 5</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_4</name>
                           <value>0x3</value>
                           <description>Divide clock source by 4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_3</name>
                           <value>0x2</value>
                           <description>Divide clock source by 3</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_2</name>
                           <value>0x1</value>
                           <description>Divide clock source by 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIV_BY_1</name>
                           <value>0x0</value>
                           <description>Do not divide clock source</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CLKCFG1</name>
               <description>Clock configuration register 1. This register is used to configure serial clock rate and clock count for delayed sampling in controller mode.</description>
               <addressOffset>268</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DSAMPLE</name>
                     <description>Delayed sampling. In controller mode the data on the POCI pin will be delayed sampled by the defined CLKSVT clock cycles. DSAMPLE values can range from 0 to SCR+1. Typically, values of 1 or 2 would suffice.</description>
                     <bitRange>[19:16]</bitRange>
                  </field>
                  <field>
                     <name>SCR</name>
                     <description>Serial clock divider. This is used to generate the transmit and receive bit rate of the SPI.
The SPI bit rate: (SPI functional clock frequency)/((SCR+1)*PRESC). SCR value can be from 0 to 1023.</description>
                     <bitRange>[9:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>IFLS</name>
               <description>Interrupt FIFO level select register. This register can be used to define the levels at which the RIS.TX, RIS.RX flags are triggered. The interrupts are generated based on FIFO level. Out of reset, the IFLS.TXSEL and IFLS.RXSEL bits are configured so that the FIFOs trigger an interrupt at the half-way mark. </description>
               <addressOffset>272</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000202</resetValue>
               <fields>
                  <field>
                     <name>RXSEL</name>
                     <description>Receive FIFO Level Select. The trigger points for the receive interrupt are as follows: </description>
                     <bitRange>[10:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LEVEL_1</name>
                           <value>0x7</value>
                           <description>Trigger when RX FIFO contains $gt;= 1 byte
</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_RES6</name>
                           <value>0x6</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_FULL</name>
                           <value>0x5</value>
                           <description>RX FIFO is full</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_RES4</name>
                           <value>0x4</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_3_4</name>
                           <value>0x3</value>
                           <description>RX FIFO $gt;= 3/4 full</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_1_2</name>
                           <value>0x2</value>
                           <description>RX FIFO $gt;= 1/2 full (default)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_1_4</name>
                           <value>0x1</value>
                           <description>RX FIFO $gt;= 1/4 full</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_OFF</name>
                           <value>0x0</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXSEL</name>
                     <description>Transmit FIFO Level Select. The trigger points for the transmit interrupt are as follows: </description>
                     <bitRange>[2:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>LEVEL_1</name>
                           <value>0x7</value>
                           <description>Trigger when TX FIFO has $gt;= 1 byte free
</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_RES6</name>
                           <value>0x6</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_EMPTY</name>
                           <value>0x5</value>
                           <description>TX FIFO is empty</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_RES4</name>
                           <value>0x4</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_1_4</name>
                           <value>0x3</value>
                           <description>TX FIFO $lt;= 1/4 empty</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_1_2</name>
                           <value>0x2</value>
                           <description>TX FIFO $lt;= 1/2 empty (default)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_3_4</name>
                           <value>0x1</value>
                           <description>TX FIFO $lt;= 3/4 empty</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVL_OFF</name>
                           <value>0x0</value>
                           <description>Reserved</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DMACR</name>
               <description>uDMA Control Register</description>
               <addressOffset>276</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TXEN</name>
                     <description>Transmit DMA enable. If this bit is set to 1, DMA for the transmit FIFO is enabled.</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable TX DMA</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable TX DMA</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXEN</name>
                     <description>Receive DMA enable. If this bit is set to 1, DMA for the receive FIFO is enabled.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable RX DMA</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable RX DMA</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXCRC</name>
               <description>Receive CRC register. Reading this register provides the computed CRC value from the receive side CRC unit. Reading this register or writing to this register with any value auto initializes the seed. The seed value is 0xFF when CTL0.CRCPOLY = 0 and 0xFFFF when CTL0.CRCPOLY = 1 for CCITT CRC polynomials. Bits[15:8] are don&#39;t care when CTL0.CRCPOLY = 0.</description>
               <addressOffset>280</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>CRC value
SW should read RXCRC register at the end of data transmission to reinitialize the seed value to all ones</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXCRC</name>
               <description>Transmit CRC register. Reading this register provides the computed CRC value from the transmit side CRC unit. Reading this register or writing to this register with any value auto initializes the seed. The seed value is 0xFF when CTL0.CRCPOLY = 0 and 0xFFFF when CTL0.CRCPOLY = 1 for CCITT CRC polynomials. Bits[15:8] are don&#39;t care when CTL0.CRCPOLY = 0.</description>
               <addressOffset>284</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>AUTOCRCINS</name>
                     <description>Status to indicate if Auto CRC has been inserted into TXFIFO.
This is applicable only if CTL0.AUTOCRC enable bit is set.
SW should read TXCRC register to clear auto inserted CRC at the end of the transfer.</description>
                     <bitRange>[31:31]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INS</name>
                           <value>0x1</value>
                           <description>Auto CRC inserted</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOTINS</name>
                           <value>0x0</value>
                           <description>Auto CRC not yet inserted</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATA</name>
                     <description>CRC value</description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXFHDR32</name>
               <description>Header update register for 32 bits of header data into the TXFIFO.</description>
               <addressOffset>288</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>This field can be used to write four bytes of header data into the TXFIFO</description>
                     <bitRange>[31:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXFHDR24</name>
               <description>Header update register for 24 bits of header data into the TXFIFO.</description>
               <addressOffset>292</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>This field can be used to write three bytes of header data into the TXFIFO.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXFHDR16</name>
               <description>Header update register for 16 bits of data into the TXFIFO.</description>
               <addressOffset>296</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>This field can be used to write two bytes of header data into the TXFIFO.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXFHDR8</name>
               <description>Header update register for 8 bits of header data into the TXFIFO.</description>
               <addressOffset>300</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>This field can be used to write one byte of header data into the TXFIFO.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>write-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXFHDRC</name>
               <description>Atomic Header Control register</description>
               <addressOffset>304</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CSGATE</name>
                     <description>Chip Select Gating control register. If this bit is set, header update register writes are blocked when chip select (CS) is active low, and HDRIGN bit is set.
This bit resets to 0.
</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BLK</name>
                           <value>0x1</value>
                           <description>Header update register writes are blocked when CS is active (low)</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UNBLK</name>
                           <value>0x0</value>
                           <description>The first header update register write is not blocked based on CS active status (low). 
If no header update occurred when CS was high (inactive), the first header update is allowed when CS is low (active), and the HDRCMT bit is set. The use case is for the external controller to ensure that the SCLK is not driven during this header update.
If the header is already updated when CS is high and inactive, HDRCMT is set immediately when CS drops to active low state, and header writes when CS is low are ignored even if this UNBLK bit is set.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HDRCMT</name>
                     <description>Header Committed field. This bit is set when the HDREN bit is set and CS is sampled low. This bit remains 0 otherwise. When set, this bit can be written to a value of 0 to clear.</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Header update is committed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Header update is not committed</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HDRIGN</name>
                     <description>Header Ignored field. When CSGATE is set to BLK, this bit is set when the last Header update register TXFHDRn is written when CS is low or HDRCMT is already set. When CSGATE is set to UNBLK, this bit is set only when the header update register is written when HDRCMT is already set. This bit remains 0 otherwise. When set, this bit can be written to a value of 0 to clear.
</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Header update is ignored</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Header update is not ignored</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HDREN</name>
                     <description>Header enable field. When CSGATE is set to BLK, this bit has to be set by software to enable atomic header feature. When CSGATE is set to UNBLK, this field is set automatically whenever a write to header update registers  TXFHDRn occurs.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Atomic header update feature enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Atomic header update feature disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RXDATA</name>
               <description>RXDATA Register. Reading this register returns first value in the RX FIFO. If the FIFO is empty the last read value is returned. Writing has no effect and is ignored.</description>
               <addressOffset>320</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>Received Data. When read, the entry in the receive FIFO, pointed to by the current FIFO read pointer is accessed. As data values are read by the receive logic from the incoming data frame, they are placed into the entry in the receive FIFO, pointed to by the current RX FIFO write pointer.
Received data less than 16 bits is automatically right-justified in the receive buffer.</description>
                     <bitRange>[15:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TXDATA</name>
               <description>TXDATA Register. Writing a value in this register puts the data into the TX FIFO. Reading this register returns the last written value.
</description>
               <addressOffset>336</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>DATA</name>
                     <description>Transmit Data. When read, the last entry in the transmit FIFO, pointed to by the current FIFO write pointer is accessed. 
When written, the entry in the TX FIFO pointed to by the write pointer, is written to. Data values are read from the transmit FIFO by the transmit logic. It is loaded into the transmit serial shifter, then serially shifted out onto the output pin at the programmed bit rate.
When a data size of less than 16 bits is selected, the user must right-justify data written to the transmit FIFO. The transmit logic ignores the unused bits. </description>
                     <bitRange>[15:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>STA</name>
               <description>Status Register</description>
               <addressOffset>352</addressOffset>
               <access>read-write</access>
               <resetValue>0x0000000f</resetValue>
               <fields>
                  <field>
                     <name>TXFIFOLVL</name>
                     <description>Indicates how many locations of TXFIFO are currently filled with data</description>
                     <bitRange>[13:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>TXDONE</name>
                     <description>Transmit done. Indicates whether the last bit has left the Shift register after a transmission
</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TX_DONE</name>
                           <value>0x1</value>
                           <description>Last bit has been shifted out, and the transmission is done</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TX_ONGOING</name>
                           <value>0x0</value>
                           <description>Last bit has not yet left the Shift register, and the transmission is ongoing.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSD</name>
                     <description>Detection of CS deassertion in the middle of a data frame transmission results in this error being set. This feature is only available in the peripheral mode.</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ERR</name>
                           <value>0x1</value>
                           <description>An error is generated when CS posedge (deassertion) is detected before the entire data frame is transmitted.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOERR</name>
                           <value>0x0</value>
                           <description>No CS posedge is detected before the entire data frame has been transmitted.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <description>SPI Busy status</description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ACTIVE</name>
                           <value>0x1</value>
                           <description>SPI is currently transmitting and/or receiving data, or transmit FIFO is not empty.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>SPI is in idle mode.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RNF</name>
                     <description>Receive FIFO not full status.</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NOT_FULL</name>
                           <value>0x1</value>
                           <description>Receive FIFO is not full.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FULL</name>
                           <value>0x0</value>
                           <description>Receive FIFO is full.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RFE</name>
                     <description>Receive FIFO empty status.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EMPTY</name>
                           <value>0x1</value>
                           <description>Receive FIFO is empty.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_EMPTY</name>
                           <value>0x0</value>
                           <description>Receive FIFO is not empty.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TNF</name>
                     <description>Transmit FIFO not full status.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>NOT_FULL</name>
                           <value>0x1</value>
                           <description>Transmit FIFO is not full.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FULL</name>
                           <value>0x0</value>
                           <description>Transmit FIFO is full.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TFE</name>
                     <description>Transmit FIFO empty status.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EMPTY</name>
                           <value>0x1</value>
                           <description>Transmit FIFO is empty.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOT_EMPTY</name>
                           <value>0x0</value>
                           <description>Transmit FIFO is not empty.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>SRAMCTRL</name>
         <description>System SRAM Controller</description>
         <baseAddress>0x400C5000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>DESC</name>
               <description>
This register identifies the peripheral
</description>
               <addressOffset>0</addressOffset>
               <access>read-only</access>
               <resetValue>0x1a480010</resetValue>
               <fields>
                  <field>
                     <name>MODID</name>
                     <description>Module identifier</description>
                     <bitRange>[31:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STDIPOFF</name>
                     <description>64 B Standard IP MMR block$lt;br$gt;0: STDIP MMRs do not exist$lt;br$gt;1:15: These MMRs begin at offset 64*STDIPOFF from IP base address</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INSTIDX</name>
                     <description>IP Instance number</description>
                     <bitRange>[11:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MAJREV</name>
                     <description>Major revision</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor revision</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>DTB</name>
               <description>
This bit field is used to select DTB mux digital inputs
</description>
               <addressOffset>100</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SEL</name>
                     <description>DTB Selection</description>
                     <bitRange>[1:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>CFG</name>
               <description>
Configuration Register
</description>
               <addressOffset>256</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PARDBGEN</name>
                     <description>SRAM Parity Debug Enable.</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable Parity Debug. An address offset can be written to PARDBG.ADDR and parity errors will be generated on reads from within this offset</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable Parity Debug. Normal operation</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PAREN</name>
                     <description>SRAM Parity Enable.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable Parity</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable Parity</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>INITSEL</name>
               <description>
Initilizataion Select Register.
</description>
               <addressOffset>260</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SEL</name>
                     <description>Bank Select. Bit[0]:Bank-0 Bit[1]:Bank-1 ... Bit[n]:Bank-n</description>
                     <bitRange>[6:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>INITTRIG</name>
               <description>
Initilizataion Select Register. This register is writable only if CFG.LOCKDIS = 1
</description>
               <addressOffset>264</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TRG</name>
                     <description>Trigger Initilization. All banks with its INIT.SEL[x] bit set to 1 will be initilizaed. This bit will auto clear once initlization is complete</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>INITSTAT</name>
               <description>
Initilizataion Status
</description>
               <addressOffset>268</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <description>Each bit indicate that corresponding bank is getting initialzed</description>
                     <bitRange>[6:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>PARDBG</name>
               <description>
Parity error check debug address setting
</description>
               <addressOffset>272</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ADDR</name>
                     <description>Debug Parity Error Address Offset.##br##When CFG.PARDBGEN is 1, this field is used to set a parity debug address offset. Writes within this address offset will force incorrect parity bits to be stored together with the data written. The following reads within this same address offset will thus result in parity errors to be generated.</description>
                     <bitRange>[19:2]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>PARERR</name>
               <description>
Parity error
</description>
               <addressOffset>276</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>ADDR</name>
                     <description>Parity Error Address Offset.##br##This holds the address offset that first generated the parity error and an interrupt is generated. ##br##This register is &#39;Clear-On-Read&#39;</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>SYS0</name>
         <description>This is top module of SYS0
</description>
         <baseAddress>0x40004000</baseAddress>
         <addressBlock>
            <offset>0x0</offset>
            <size>0x00001000</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>DESC</name>
               <description>Description Register 
This register provides IP module ID, revision information, instance index and standard MMR registers offset.</description>
               <addressOffset>0</addressOffset>
               <access>read-only</access>
               <resetValue>0x6b4e0010</resetValue>
               <fields>
                  <field>
                     <name>MODID</name>
                     <description>Module Identifier is used to uniquely identify this IP</description>
                     <bitRange>[31:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STDIPOFF</name>
                     <description>Standard IP MMR block offset. Standard IP MMRs are the set from aggregated IRQ registers till DTB.

0: Standard IP MMRs do not exist

0x1-0xF: Standard IP MMRs begin at offset of (64*STDIPOFF from the base IP address)</description>
                     <bitRange>[15:12]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>INSTIDX</name>
                     <description>IP Instance ID number. If multiple instances of IP exist in the device, this field can identify the instance number (0-15).</description>
                     <bitRange>[11:8]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MAJREV</name>
                     <description>Major revision of IP (0-15).</description>
                     <bitRange>[7:4]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>MINREV</name>
                     <description>Minor revision of IP (0-15).</description>
                     <bitRange>[3:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>MUNLOCK</name>
               <description>Mutable section Unlock
This register unlocks registers in mutable section
</description>
               <addressOffset>12</addressOffset>
               <access>write-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>KEY</name>
                     <description>Write the unlock key 0xC5AF6927 to temporarily unlock registers in mutable section. The lock is set automatically if no write accesses, to the mutable section, are detected for consecutive 32 CLKULL (24MHz) clock cycles. Writing any value other than that, the unlock key will immediately lock the mutable register space for write access.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>UNLOCK</name>
                           <value>0xc5af6927</value>
                           <description>Unlock registers in the mutable section</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOCK</name>
                           <value>0x0</value>
                           <description>Lock registers in the mutable section</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ATESTCFG</name>
               <description>ATEST Configuration
This register is used to configure analog switches in ATEST module.
</description>
               <addressOffset>256</addressOffset>
               <access>read-write</access>
               <resetValue>0x0000000f</resetValue>
               <fields>
                  <field>
                     <name>KEY</name>
                     <description>Key must be written with value 0x5A for successful write to ATESTCFG and to unlock register state. 
Write with any value other than 0x5A to KEY will be ignored and register content is not updated.
It is recommended to write this register with incorrect KEY to lock back register state after necessary ATESTCFG updates are done. 
Read value of KEY is 0x0.</description>
                     <bitRange>[31:24]</bitRange>
                     <access>write-only</access>
                  </field>
                  <field>
                     <name>VSEL</name>
                     <description>Selects supply for ATEST switches.
</description>
                     <bitRange>[8:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VDDS</name>
                           <value>0x1</value>
                           <description>Selects VDDS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VDDBST</name>
                           <value>0x0</value>
                           <description>Selects VDDBOOST</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VA2VA1</name>
                     <description>Enables isolation switch between VA_ATEST_A1 and VA_PAD_A1.</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VA2VA0</name>
                     <description>Enables isolation switch between VA_ATEST_A0 and VA_PAD_A0.</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VR2VA1</name>
                     <description>Enables isolation switch between VR_ATEST_A1 and VA_ATEST_A1.</description>
                     <bitRange>[5:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VR2VA0</name>
                     <description>Enables isolation switch between VR_ATEST_A0 and VA_ATEST_A0.</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SHTVA1</name>
                     <description>Shorts VA_ATEST_A1 to ground.</description>
                     <bitRange>[3:3]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SHTVA0</name>
                     <description>Shorts VA_ATEST_A0 to ground.</description>
                     <bitRange>[2:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SHTVR1</name>
                     <description>Shorts VR_ATEST_A1 to ground.</description>
                     <bitRange>[1:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SHTVR0</name>
                     <description>Shorts VR_ATEST_A0 to ground.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLOSE</name>
                           <value>0x1</value>
                           <description>Switch is closed</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>Switch is open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TSENSCFG</name>
               <description>TSENSE Configuration
This register is used to configure temperature sensor module. 
</description>
               <addressOffset>264</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>TSENS2EN</name>
                     <description>This is the enable bit for the second temperature sensor in AUX. </description>
                     <bitRange>[11:11]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Second temperature sensor is enabled.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Second temperature sensor is disabled.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SEL</name>
                     <description>Used to enable and configure temperature sensor module. Setting the value to 0x3 will disable the temperature sensor.</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>GND</name>
                           <value>0x2</value>
                           <description>20uA current is injected on VR_ATEST_A0 and ground measured on VR_ATEST_A1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VALUE</name>
                           <value>0x1</value>
                           <description>20uA current is injected on VR_ATEST_A0 and voltage measured on VR_ATEST_A1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLE</name>
                           <value>0x0</value>
                           <description>Temperature sensor is disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LPCMPCFG</name>
               <description>LPCMP configuration
This register is used to configure and check the status of low-power comparator (LPCOMP) module.
</description>
               <addressOffset>268</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>HYSPOL</name>
                     <description>Hysteresis polarity</description>
                     <bitRange>[30:30]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>INV</name>
                           <value>0x1</value>
                           <description>Inverted</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOINV</name>
                           <value>0x0</value>
                           <description>Not inverted</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ATESTMUX</name>
                     <description>Used to configure ATEST mux in comparator module and provides chosen output on VA_ATEST_A0.
Note: This bit field is write-protected using global lock indicator on production device.</description>
                     <bitRange>[29:28]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>IBIASOUT</name>
                           <value>0x3</value>
                           <description>Selects bias current output</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COMP_VIN_NEG</name>
                           <value>0x2</value>
                           <description>Selects voltage divider output</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COMPOUT</name>
                           <value>0x1</value>
                           <description>Selects comparator output</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OFF</name>
                           <value>0x0</value>
                           <description>ATEST mux is off</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EVTIFG</name>
                     <description>Event flag

The event flag is set when the comparator output transition is qualified based on the edge polarity configuration in EDGCFG.

</description>
                     <bitRange>[24:24]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SET</name>
                           <value>0x1</value>
                           <description>Set</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x0</value>
                           <description>Clear</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>COUTEN</name>
                     <description>Enables LPCOMP output on device pin.</description>
                     <bitRange>[21:21]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>COUT</name>
                     <description>LPCOMP output status. This bit captures the value LPCOMP raw output.</description>
                     <bitRange>[20:20]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <value>0x1</value>
                           <description>Output is high</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOW</name>
                           <value>0x0</value>
                           <description>Output is low</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WUENSB</name>
                     <description>Enables lpcmpcfg output to wake device from standby.</description>
                     <bitRange>[18:18]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EVTEN</name>
                     <description>Enables event generation. Comparator module will produce event on ULL event fabric when EVTIFG is set.</description>
                     <bitRange>[17:17]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EDGCFG</name>
                     <description>Selects positive edge or negative edge detection on comparator output to set the event flag</description>
                     <bitRange>[16:16]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FALL</name>
                           <value>0x1</value>
                           <description>Fall edge detection</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RISE</name>
                           <value>0x0</value>
                           <description>Rise edge detection</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NSEL</name>
                     <description>Negative input selection. Setting values 0x5-0x7 will open all the switches.</description>
                     <bitRange>[14:12]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VDDD</name>
                           <value>0x4</value>
                           <description>Selects VDDD</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VDDS</name>
                           <value>0x3</value>
                           <description>Selects VDDS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_PAD_A3</name>
                           <value>0x2</value>
                           <description>Selects VA_PAD_A3</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_PAD_A2</name>
                           <value>0x1</value>
                           <description>Selects VA_PAD_A2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>All switches are open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PSEL</name>
                     <description>Positive input selection. Setting values 0x9-0xF will open all the switches.</description>
                     <bitRange>[11:8]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VDDS</name>
                           <value>0x8</value>
                           <description>Selects VDDS</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_ATEST_A1</name>
                           <value>0x7</value>
                           <description>Selects VA_ATEST_A1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_ATEST_A0</name>
                           <value>0x6</value>
                           <description>Selects VA_ATEST_A0</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VR_ATEST_A1</name>
                           <value>0x5</value>
                           <description>Selects VR_ATEST_A1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VR_ATEST_A0</name>
                           <value>0x4</value>
                           <description>Selects VR_ATEST_A0</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_PAD_A3</name>
                           <value>0x3</value>
                           <description>Selects VA_PAD_A3</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_PAD_A2</name>
                           <value>0x2</value>
                           <description>Selects VA_PAD_A2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VA_PAD_A1</name>
                           <value>0x1</value>
                           <description>Selects VA_PAD_A1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPEN</name>
                           <value>0x0</value>
                           <description>All switches are open</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HYSSEL</name>
                     <description>Used to enable and select hysteresis level

Hysteresis is disabled when HYSSEL = 0 and enabled for other values of HYSSEL from 1 to 7. Refer to device specific datasheet for individual hysteresis values.

</description>
                     <bitRange>[7:5]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VAL7</name>
                           <value>0x7</value>
                           <description>Hysteresis value 7</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL6</name>
                           <value>0x6</value>
                           <description>Hysteresis value 6</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL5</name>
                           <value>0x5</value>
                           <description>Hysteresis value 5 </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL4</name>
                           <value>0x4</value>
                           <description>Hysteresis value 4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL3</name>
                           <value>0x3</value>
                           <description>Hysteresis value 3</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL2</name>
                           <value>0x2</value>
                           <description>Hysteresis value 2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL1</name>
                           <value>0x1</value>
                           <description>Hysteresis value 1</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL0</name>
                           <value>0x0</value>
                           <description>Hysteresis is disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIVPATH</name>
                     <description>Used to select the path on which voltage divider is applied</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PSIDE</name>
                           <value>0x1</value>
                           <description>Divider is applied on P-side</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NSIDE</name>
                           <value>0x0</value>
                           <description>Divider is applied on N-side</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIV</name>
                     <description>Used to configure reference divider. Setting values 0x5-0x7 will set the divide value to 1.</description>
                     <bitRange>[3:1]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VAL4</name>
                           <value>0x4</value>
                           <description>Divide value is 1/4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL3</name>
                           <value>0x3</value>
                           <description>Divide value is 1/3</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL2</name>
                           <value>0x2</value>
                           <description>Divide value is 1/2</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL1</name>
                           <value>0x1</value>
                           <description>Divide value is 3/4</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL0</name>
                           <value>0x0</value>
                           <description>Divide value is 1</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>Used to enable comparator module.</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>VGMCFG</name>
