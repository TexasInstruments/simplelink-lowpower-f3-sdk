                     <name>B2NM1</name>
                     <description>Write/Erase Protection for B2NM1</description>
                     <bitRange>[6:6]</bitRange>
                  </field>
                  <field>
                     <name>B2NM0</name>
                     <description>Write/Erase Protection for B2NM0</description>
                     <bitRange>[5:5]</bitRange>
                  </field>
                  <field>
                     <name>VLOG</name>
                     <description>Write/Erase Protection for VLOG</description>
                     <bitRange>[4:4]</bitRange>
                  </field>
                  <field>
                     <name>SCFG</name>
                     <description>Write/Erase Protection for SCFG</description>
                     <bitRange>[3:3]</bitRange>
                  </field>
                  <field>
                     <name>ENGR</name>
                     <description>Write/Erase Protection for ENGR</description>
                     <bitRange>[2:2]</bitRange>
                  </field>
                  <field>
                     <name>FCFG</name>
                     <description>Write/Erase Protection for FCFG</description>
                     <bitRange>[1:1]</bitRange>
                  </field>
                  <field>
                     <name>CCFG</name>
                     <description>Write/Erase Protection for CCFG</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>FLBSTA</name>
               <description>
Flash Status. This register is used to indicate status of flash.
</description>
               <addressOffset>1056</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>B3BSY</name>
                     <description>Bank 3 Busy. This bit indicates if flash Bank 3 is busy.</description>
                     <bitRange>[7:7]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>Idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>B2BSY</name>
                     <description>Bank 2 Busy. This bit indicates if flash Bank 2 is busy.</description>
                     <bitRange>[6:6]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>Idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>B1BSY</name>
                     <description>Bank 1 Busy. This bit indicates if flash Bank 1 is busy.</description>
                     <bitRange>[5:5]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>Idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>B0BSY</name>
                     <description>Bank 0 Busy. This bit indicates if flash Bank 0 is busy.</description>
                     <bitRange>[4:4]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>Idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PARERR</name>
                     <description>Parity Error. This bit indicates parity error on write/erase $amp; read protection MMRs. This bit is sticky when set to 1 by hardware.</description>
                     <bitRange>[3:3]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ERR</name>
                           <value>0x1</value>
                           <description>Error</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOERR</name>
                           <value>0x0</value>
                           <description>No Error</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BUSY</name>
                     <description>This bit indicates if flash is busy.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x0</value>
                           <description>Idle</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FL2TRDY</name>
                     <description>Flash 2T Ready. This bit indicates if flash is ready in 2T mode.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RDY</name>
                           <value>0x1</value>
                           <description>Ready</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOTRDY</name>
                           <value>0x0</value>
                           <description>Not Ready</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FL1TRDY</name>
                     <description>Flash 1T Ready. This bit indicates if flash is ready in 1T mode.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>RDY</name>
                           <value>0x1</value>
                           <description>Ready</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOTRDY</name>
                           <value>0x0</value>
                           <description>Not Ready</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCHCTL</name>
               <description>
Cache Control Register. This register is used for cache control on code bus Interface. This register can only be written when CCHSTA.BUSY is 0
</description>
               <addressOffset>1060</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000091</resetValue>
               <fields>
                  <field>
                     <name>HCHFLUSH</name>
                     <description>Cache Flush for HSM Cache. This bit is used to flush the cache on HSM bus Interface. This bit is self clearing</description>
                     <bitRange>[16:16]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TRG</name>
                           <value>0x1</value>
                           <description>Trigger Flush</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CNTCLR</name>
                     <description>Cache Hit/Miss Count Clear. Writing 0 to this bit has no affect</description>
                     <bitRange>[8:8]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Clear Hit/Miss Counter</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CNTEN</name>
                     <description>Cache Hit/Miss Count Enable.</description>
                     <bitRange>[7:7]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RPOLICY</name>
                     <description>Replacement policy for Cache.</description>
                     <bitRange>[6:6]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>SEQ</name>
                           <value>0x1</value>
                           <description>Sequencial Replacement Policy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RND</name>
                           <value>0x0</value>
                           <description>Random Replacement Policy</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LINFLUSH</name>
                     <description>Line Buffer Flush. This bit is used to flush the Line buffer on system bus Interface. Writing 0 to this bit has no affect.
The guideline to use the flush:
1. Write CCHCTL.LINFLUSH = 1 (Will flush the SAHB cache)
2. Write CCHCTL.LINFLUSH = 0 (Forcing to disable the Flush)</description>
                     <bitRange>[5:5]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TRG</name>
                           <value>0x1</value>
                           <description>Trigger Flush</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LINEN</name>
                     <description>Line Buffer Enable. This bit is used to enable the Line buffer on system bus Interface. Disabling the Line buffer will flush it</description>
                     <bitRange>[4:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CCHFLUSH</name>
                     <description>Cache Flush. This bit is used to flush the cache on code bus Interface. This bit is self clearing. Writing 0 to this bit has no affect</description>
                     <bitRange>[3:3]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>TRG</name>
                           <value>0x1</value>
                           <description>Trigger Flush</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CCHEN</name>
                     <description>Cache Enable. This bit is used to enable the cache. Disabling the cache will flush it</description>
                     <bitRange>[0:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enable</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disable</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CCHSTA</name>
               <description>
Cache Status. This register gives cache status
</description>
               <addressOffset>1064</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000003</resetValue>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <description>Busy. This bit indicate Cache is changing state</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>BUSY</name>
                           <value>0x1</value>
                           <description>Busy</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NBUSY</name>
                           <value>0x0</value>
                           <description>Not Busy</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN</name>
                     <description>Enabled. This bit indicate whether cache is enabled or disabled</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EN</name>
                           <value>0x1</value>
                           <description>Enabled</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>Disabled</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNTHIT</name>
               <description>
Cache Hit Counter
</description>
               <addressOffset>1072</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Hit Counter Value. This counter is cleared by writing CCHCTL.CNTCLR</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>CNTMISS</name>
               <description>
Cache Miss Counter
</description>
               <addressOffset>1076</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Miss Counter Value. This counter is cleared by writing CCHCTL.CNTCLR</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>WEPRB2</name>
               <description>
Write Erase Protect Main Bank 2. This register allows physical bank 2 main region sectors to be protected from program and  erase. Each bit corresponds to a group of 8 sectors.
</description>
               <addressOffset>1080</addressOffset>
               <access>read-write</access>
               <resetValue>0xffffffff</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Flash write/erase protection configuration value.</description>
                     <bitRange>[31:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>WEPRB3</name>
               <description>
Write Erase Protect Main Bank 3. This register allows physical bank 3 main region sectors to be protected from program and  erase. Each bit corresponds to a group of 8 sectors.
</description>
               <addressOffset>1084</addressOffset>
               <access>read-write</access>
               <resetValue>0xffffffff</resetValue>
               <fields>
                  <field>
                     <name>VAL</name>
                     <description>Flash write/erase protection configuration value.</description>
                     <bitRange>[31:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>DTB</name>
               <description>
Digital test bus control register. This register can be used to bring out IP internal signals to the pads for observation. 16 signals can be observed per select value.
</description>
               <addressOffset>2048</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>SEL</name>
                     <description>Digital test bus selection mux control.
Non-zero select values output a 16 bit selected group of signals per value.</description>
                     <bitRange>[3:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>DIS</name>
                           <value>0x0</value>
                           <description>DTB output from peripheral is 0x0</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
   </peripherals>
</device>
