                  </field>
                  <field>
                     <name>FLAG0</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>CLR</name>
                           <value>0x1</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOEFF</name>
                           <value>0x0</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYSFSTA</name>
               <description>Internal. Only to be used through TI provided API.</description>
               <addressOffset>40</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>FLAG2</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[2:2]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VAL1</name>
                           <value>0x1</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL0</name>
                           <value>0x0</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLAG1</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[1:1]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VAL1</name>
                           <value>0x1</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FLAG0</name>
                     <description>Internal. Only to be used through TI provided API.</description>
                     <bitRange>[0:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>VAL1</name>
                           <value>0x1</value>
                           <description>Internal. Only to be used through TI provided API.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VAL0</name>
