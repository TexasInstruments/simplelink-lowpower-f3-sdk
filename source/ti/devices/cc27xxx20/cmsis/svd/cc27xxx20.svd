               <resetValue>0x0999999a</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <description>Enable tracking loop.</description>
                     <bitRange>[31:31]</bitRange>
                  </field>
                  <field>
                     <name>DSMBYP</name>
                     <description>Bypass Delta-Sigma-Modulation of fine trim.</description>
                     <bitRange>[30:30]</bitRange>
                  </field>
                  <field>
                     <name>RATIO</name>
                     <description>Ratio. Ratio format is 0b.30b</description>
                     <bitRange>[29:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>_79MHZ</name>
                           <value>0x9b8b578</value>
