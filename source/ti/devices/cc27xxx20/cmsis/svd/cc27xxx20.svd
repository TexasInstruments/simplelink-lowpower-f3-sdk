                  </field>
                  <field>
                     <name>SRC1</name>
                     <description>Select source of systimer output event 1 (capture source)</description>
                     <bitRange>[7:4]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>PBESYSTIM2</name>
