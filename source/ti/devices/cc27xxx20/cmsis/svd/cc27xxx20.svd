               <name>LFMONCTL</name>
               <description>Low-frequency clock-monitor control</description>
               <addressOffset>176</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>EN</name>
                     <description>Enable LFMONITOR.
Enable only after a LF clock source has been selected, enabled and is stable.
If LFMONITOR detects a clock loss, the system will be reset.</description>
                     <bitRange>[0:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFINCCTL2</name>
               <description>Low frequency time increment control-2</description>
               <addressOffset>180</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000002</resetValue>
               <fields>
                  <field>
                     <name>ADJUSTLFINC</name>
                     <description>Adjusts LFINC while transitioning from fake to real LF clock if necessary. For the adjustment to happen, tracking loop must be running.</description>
                     <bitRange>[31:31]</bitRange>
                  </field>
                  <field>
                     <name>GEARRSTRTLIM</name>
                     <description>Specifies the number of times gear could be restarted before raising an interrupt. It has no impact on the number of times gear can be reduced.
A value of 0 indicates that the interrupt mechanism is disabled</description>
                     <bitRange>[9:4]</bitRange>
                  </field>
                  <field>
                     <name>GEARREDCNT</name>
                     <description>Specifies the number by which gear should be reduced post standby exit</description>
                     <bitRange>[3:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>LFCLKSEL</name>
               <description>Low frequency clock selection</description>
               <addressOffset>192</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>PRE</name>
                     <description>Select low frequency clock source for the PRELFCLK interrupt.

Can be used by Software to confirm that the clock is running and it&#39;s frequency is good, before selecting it in MAIN.</description>
                     <bitRange>[3:2]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EXTLF</name>
                           <value>0x3</value>
                           <description>External LF clock through GPI.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LFXT</name>
                           <value>0x2</value>
                           <description>Low frequency crystal oscillator</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LFOSC</name>
                           <value>0x1</value>
                           <description>Low frequency on-chip oscillator</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NONE</name>
                           <value>0x0</value>
                           <description>No clock. Output will be tied low.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MAIN</name>
                     <description>Select the main low frequency clock source.

If running, this clock will be used to generate LFTICK and as CLKULL during STANDBY.
If not running, LFTICK will be generated from HFOSC and STANDBY entry will be prevented.</description>
                     <bitRange>[1:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>EXTLF</name>
                           <value>0x3</value>
                           <description>External LF clock through GPI.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LFXT</name>
                           <value>0x2</value>
                           <description>Low frequency crystal oscillator</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LFOSC</name>
                           <value>0x1</value>
                           <description>Low frequency on-chip oscillator</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FAKE</name>
                           <value>0x0</value>
                           <description>No LF clock selected. LFTICK will be generated from HFOSC, STANDBY entry will be prevented.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
