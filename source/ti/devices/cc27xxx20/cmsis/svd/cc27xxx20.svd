            <register>
               <name>TRACKSTATAF</name>
               <description>AF tracking loop status information</description>
               <addressOffset>352</addressOffset>
               <access>read-only</access>
               <resetValue>0x00001d80</resetValue>
               <fields>
                  <field>
                     <name>LOOPERRVLD</name>
                     <description>Current AFOSC tracking error valid

This bit is one if the tracking loop is running and the error value is valid.</description>
                     <bitRange>[31:31]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>LOOPERR</name>
                     <description>Current AFOSC tracking error

This field uses the internal fractional representation (sign, 9 integer bits, 4 fractional bits).
The actual fine trim value of format (sign, 9 integer bits, 30 fractional bits) is saturated to (sign, 9 integer bits, 4 fractional bits).</description>
                     <bitRange>[29:16]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>FINETRIM</name>
                     <description>Current AFOSC Fine-trim value

This field uses the internal fractional representation (sign, 5 integer bits, 7 fractional bits).
The actual fine trim value of format (sign, 5 integer bits, 19 fractional bits) is saturated to (sign, 5 integer bits, 7 fractional bits).
The actual trim value applied to the oscillator is delta-sigma modulated 6 bits non-signed
(inverted sign bit + integer bits).</description>
                     <bitRange>[12:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TRACKSTATAF1</name>
               <description>AF tracking loop status information</description>
               <addressOffset>356</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>LOOPERR</name>
                     <description>Current AFOSC tracking error

This field uses the fractional representation of the actual error(30 fractional bits). The actual error is of format (sign, 9 integer bits, 30 fractional bits).</description>
                     <bitRange>[29:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>TRACKSTATAF2</name>
               <description>AF tracking loop status information</description>
               <addressOffset>360</addressOffset>
               <access>read-write</access>
               <resetValue>0x01d80000</resetValue>
               <fields>
                  <field>
                     <name>FINETRIM</name>
                     <description>Current AFOSC Fine-trim value

This field uses the internal fractional representation (sign, 5 integer bits, 19 fractional bits).
The actual trim value applied to the oscillator is delta-sigma modulated 6 bits non-signed
(inverted sign bit + integer bits).

</description>
                     <bitRange>[24:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>LOOPCFGAF</name>
               <description>Configuration Register for the Audio frequency Tracking Loop</description>
               <addressOffset>368</addressOffset>
               <access>read-write</access>
               <resetValue>0x305e33b3</resetValue>
               <fields>
                  <field>
                     <name>FINETRIM_INIT</name>
                     <description>Initial value for the resistor fine trim</description>
                     <bitRange>[31:26]</bitRange>
                  </field>
                  <field>
                     <name>BOOST_TARGET</name>
                     <description>Number of error-updates using BOOST values, before using KI/KP</description>
                     <bitRange>[25:21]</bitRange>
                  </field>
                  <field>
                     <name>KP_BOOST</name>
                     <description>Proportional loop coefficient during BOOST</description>
                     <bitRange>[20:18]</bitRange>
                  </field>
                  <field>
                     <name>KI_BOOST</name>
                     <description>Integral loop coefficient during BOOST</description>
                     <bitRange>[17:15]</bitRange>
                  </field>
                  <field>
                     <name>SETTLED_TARGET</name>
                     <description>Number of updates before AFOSC is considered &#34;settled&#34;</description>
                     <bitRange>[14:10]</bitRange>
                  </field>
                  <field>
                     <name>OOR_LIMIT</name>
                     <description>Out-of-range threshold. Out-of-range threshold. OOR_LIMIT is compared with absolute value of 5 MSB bits of loop filter error.</description>
                     <bitRange>[9:6]</bitRange>
                  </field>
                  <field>
                     <name>KP</name>
                     <description>Proportional loop coefficient</description>
                     <bitRange>[5:3]</bitRange>
                  </field>
                  <field>
                     <name>KI</name>
                     <description>Integral loop coefficient</description>
                     <bitRange>[2:0]</bitRange>
                  </field>
               </fields>
            </register>
            <register>
               <name>CTL</name>
               <description>Control</description>
               <addressOffset>512</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>CMD</name>
                     <description>TDC commands.</description>
                     <bitRange>[1:0]</bitRange>
                     <access>write-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>ABORT</name>
                           <value>0x3</value>
                           <description>Force TDC state machine back to IDLE state.

Never write this command while [TDC.STAT.STATE] equals CLR_CNT or WAIT_CLR_CNT_DONE.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUN</name>
                           <value>0x2</value>
                           <description>Asynchronous counter start.

The counter starts to count when the start event is high. To achieve precise edge-to-edge measurements you must ensure that the start event is low for at least 420 ns after you write this command. </description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUN_SYNC_START</name>
                           <value>0x1</value>
                           <description>Synchronous counter start.

The counter looks for the opposite edge of the selected start event before it starts to count when the selected edge occurs. This guarantees an edge-triggered start and is recommended for frequency measurements.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR_RESULT</name>
                           <value>0x0</value>
                           <description>Clear [TDC.STAT.SAT], [TDC.STAT.DONE], and [TDC.RESULT.VALUE]. 

This is not needed as prerequisite for a measurement. Reliable clear is only guaranteed from IDLE state.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>STAT</name>
               <description>Status</description>
               <addressOffset>516</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000006</resetValue>
               <fields>
                  <field>
                     <name>SAT</name>
                     <description>TDC measurement saturation flag.

0: Conversion has not saturated.
1: Conversion stopped due to saturation.

This field is cleared when a new measurement is started or when CLR_RESULT is written to [TDC.CTL.CMD].</description>
                     <bitRange>[7:7]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>DONE</name>
                     <description>TDC measurement complete flag.

0: TDC measurement has not yet completed.
1: TDC measurement has completed.

This field clears when a new TDC measurement starts or when you write CLR_RESULT to [TDC.CTL.CMD].</description>
                     <bitRange>[6:6]</bitRange>
                     <access>read-only</access>
                  </field>
                  <field>
                     <name>STATE</name>
                     <description>TDC state machine status.</description>
                     <bitRange>[5:0]</bitRange>
                     <access>read-only</access>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>FORCE_STOP</name>
                           <value>0x2e</value>
                           <description>Current state is TDC_FORCESTOP.
You wrote ABORT to [TDC.CTL.CMD] to abort the TDC measurement.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>START_FALL</name>
                           <value>0x1e</value>
                           <description>Current state is TDC_WAIT_STARTFALL. 
The fast-counter circuit waits for a falling edge on the start event.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_CLR_CNT_DONE</name>
                           <value>0x16</value>
                           <description>Current state is TDC_STATE_WAIT_CLRCNT_DONE. 
The state machine waits for fast-counter circuit to finish reset.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>POR</name>
                           <value>0xf</value>
                           <description>Current state is TDC_STATE_POR. 
This is the reset state.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GET_RESULT</name>
                           <value>0xe</value>
                           <description>Current state is TDC_STATE_GETRESULTS.
The state machine copies the counter value from the fast-counter circuit.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_STOP_CNTDWN</name>
                           <value>0xc</value>
                           <description>Current state is TDC_STATE_WAIT_STOPCNTDOWN.
The fast-counter circuit looks for the stop condition. It will ignore a number of stop events configured in [TDC.TRIGCNTLOAD.CNT].</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_STOP</name>
                           <value>0x8</value>
                           <description>Current state is TDC_STATE_WAIT_STOP.
The state machine waits for the fast-counter circuit to stop.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLR_CNT</name>
                           <value>0x7</value>
                           <description>Current state is TDC_STATE_CLRCNT. The fast-counter circuit is reset.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDLE</name>
                           <value>0x6</value>
                           <description>Current state is TDC_STATE_IDLE. 
This is the default state after reset and abortion. State will change when you write [TDC.CTL.CMD] to either RUN_SYNC_START or RUN.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_START_STOP_CNT_EN</name>
                           <value>0x4</value>
                           <description>Current state is TDC_STATE_WAIT_STARTSTOPCNTEN.
The fast-counter circuit looks for the start condition. The state machine waits for the fast-counter to increment.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_START</name>
                           <value>0x0</value>
                           <description>Current state is TDC_STATE_WAIT_START. 
The fast-counter circuit looks for the start condition. The state machine waits for the fast-counter to increment.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RESULT</name>
               <description>Result

Result of last TDC conversion.</description>
               <addressOffset>520</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000002</resetValue>
               <fields>
                  <field>
                     <name>VALUE</name>
                     <description>TDC conversion result.

The result of the TDC conversion is given in number of clock edges of the clock source selected in [IPSPECIFIC.CKM.TDCCLKSEL.REFCLK]. Both rising and falling edges are counted.

Note that [TDC.SATCFG.LIMIT] is given in periods, while VALUE is given in edges (periods*2).
If TDC counter saturates, VALUE is slightly higher than [TDC.SATCFG.LIMIT]*2, as it takes a non-zero time to stop the measurement. Hence, the maximum value of this field becomes slightly higher than 2^31 (2^30 periods*2) if you configure [TDC.SATCFG.LIMIT] to R30.</description>
                     <bitRange>[31:0]</bitRange>
                     <access>read-only</access>
                  </field>
               </fields>
            </register>
            <register>
               <name>SATCFG</name>
               <description>Saturation Configuration</description>
               <addressOffset>524</addressOffset>
               <access>read-write</access>
               <resetValue>0x00000000</resetValue>
               <fields>
                  <field>
                     <name>LIMIT</name>
                     <description>Saturation limit.

The flag [TDC.STAT.SAT] is set when the TDC counter saturates.
Note that this value is given in periods, while [TDC.RESULT.VALUE] is given in edges (periods*2).

Values not enumerated are not supported</description>
                     <bitRange>[4:0]</bitRange>
                     <enumeratedValues>
                        <enumeratedValue>
                           <name>R30</name>
                           <value>0x15</value>
                           <description>TDC conversion saturates and stops after 2^30 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R29</name>
                           <value>0x14</value>
                           <description>TDC conversion saturates and stops after 2^29 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R28</name>
                           <value>0x13</value>
                           <description>TDC conversion saturates and stops after 2^28 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R27</name>
                           <value>0x12</value>
                           <description>TDC conversion saturates and stops after 2^27 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R26</name>
                           <value>0x11</value>
                           <description>TDC conversion saturates and stops after 2^26 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R25</name>
                           <value>0x10</value>
                           <description>TDC conversion saturates and stops after 2^25 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R24</name>
                           <value>0xf</value>
                           <description>TDC conversion saturates and stops after 2^24 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R23</name>
                           <value>0xe</value>
                           <description>TDC conversion saturates and stops after 2^23 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R22</name>
                           <value>0xd</value>
                           <description>TDC conversion saturates and stops after 2^22 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R21</name>
                           <value>0xc</value>
                           <description>TDC conversion saturates and stops after 2^21 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R20</name>
                           <value>0xb</value>
                           <description>TDC conversion saturates and stops after 2^20 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R19</name>
                           <value>0xa</value>
                           <description>TDC conversion saturates and stops after 2^19 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R18</name>
                           <value>0x9</value>
                           <description>TDC conversion saturates and stops after 2^18 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R17</name>
                           <value>0x8</value>
                           <description>TDC conversion saturates and stops after 2^17 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R16</name>
                           <value>0x7</value>
                           <description>TDC conversion saturates and stops after 2^16 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R15</name>
                           <value>0x6</value>
                           <description>TDC conversion saturates and stops after 2^15 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R14</name>
                           <value>0x5</value>
                           <description>TDC conversion saturates and stops after 2^14 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R13</name>
                           <value>0x4</value>
                           <description>TDC conversion saturates and stops after 2^13 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>R12</name>
                           <value>0x3</value>
                           <description>TDC conversion saturates and stops after 2^12 periods.</description>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NONE</name>
                           <value>0x0</value>
                           <description>No saturation. An additional timer should be used to know if [TDC.RESULT.VALUE] rolled over.</description>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
